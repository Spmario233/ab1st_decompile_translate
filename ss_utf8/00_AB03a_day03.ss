// #SCENE_SCRIPT_ID = 0004 （スクリプトＩＤ：この行は削除したり、変更したりしないで下さい）
#Z00

//@DAYS=3	***********旧設定***********
@DAYS += 1	@day_change	// 03日目
$bs_dress_init

//@岩沢消えなかった = 1 // 消えたときに 0 に倒すよう仕様変更します。ややこいけどこうしないと岩沢(いる/いない)の判定に使えない（西

;－－－□寮 火曜日

;－－－朝

@pcmch_play_loop(1, @小鳥のさえずり)//効果音(小鳥のさえずり/第３話冒頭)

IF(@降下作戦に参加しなかった==1){		// 最初の分岐１

	【@音無】"「嗯…」"R //「ん…」R
	
	@bg(ep99_bg001, 143)

	@bgm_play(m301)		;;♪日常曲（朝の寮の部屋など）
	;;@bgm_play(m106)		;;■体験版用日常曲（朝の行動時）
	
	"我感觉到了有人活动的气息，醒了过来。"R //人の動く気配がして、目覚めた。R
	
	@pcmch_stop(1, 1000)

	@bs(hn0401)
	
	"日向已经先起了床，正在打理自己。"R //先に起きていた日向が身支度をしていた。R
	【@音無】"「早上好」"R //「おはよ」R
	
	@bs(hn0201)
	KOE(000400013,010)【@日向】"「哦豁，吵醒你了吗？」"R //「おっと起こしちまったか？」R
	【@音無】"「没，我昨天毕竟没参加作战，已经睡得很足了」"R //「いや、昨日はオペレーションに参加しなかったから、十分睡眠を取れた」R

	IF(@昨日怪我した){

		@bs(hn0103)
		KOE(000400018,010)【@日向】"「身上的伤怎么样了？」"R //「怪我のほうは？」R
		"我活动着身体，确认着身上的伤。"R //俺は確かめるように全身を動かしてみる。R
		【@音無】"「已经痊愈了」"R //「ああ、治ってる」R
		
		@bs(hn0104)
		KOE(000400021,010)【@日向】"「那就太好了」"R //「そりゃ、なによりだな」R

		@野田との訓練全身刻まれた=0
		//@松下関係で怪我=0

	}

	【@音無】"「所以，昨天的作战成功了吗…？」"R //「それで結局、オペレーションは成功したのか…？」R

	GOTO #AAYURIPPE

}elseif(@ギルド降下作戦の途中で死んだ==1){		// 最初の分岐２

	@bg_pan_zd(ep99_bg001, 0, 300, 2)
	@timewaitkey(300)
	@pcmch_play(0, @起きるベッド)
	@縦揺れ_弱
	
	【@音無】"「哈！！」"R //「はっ！！」R
	"我猛地惊醒了。"R //飛び起きた。R

	@bgm_play(m301)		;;♪日常曲（朝の寮の部屋など）
	;;@bgm_play(m106)		;;■体験版用日常曲（朝の行動時）
	
	@pcmch_stop(1, 1000)

	@bs(hn0104)
	KOE(000400036,010)【@日向】"「哟，醒了吗」"R //「ようっ、起きたか」R
	【@音無】"「我后来怎么样了…？」"R //「俺はどうなっていたんだ…？」R
	"虽然还残留着一股挥之不去的恐惧感，但我完全不记得后来发生了什么。"R //張り付くような恐怖感は残っているが、どうなったか全く覚えていない。R

	IF(@音無のエロ度==1){		;;エロ少年系あだ名の判定フラグを調整します。（魁0404

		//@ゆりをオカズにした１=1 の可能性がある
		//@ゆりに蹴落とされた=1 の可能性がある
		//@ゆりをオカズにした２=1 の可能性がある

		@bs(hn0408)
		KOE(000400042,010)【@日向】"「你后脑勺着地而死了。地板上还残留着很大一滩血迹呢」"R //「後頭部を打って、死亡。床には多量の出血の跡が残されていたとさ」R
		;;【@音無】「そっか…」R
		;;@bs(hn0101_09)
		;;KOE(000400044,010)【@日向】「それと、鼻からも相当な出血が見られたそうだ。背中から落ちたのに不思議な話だな」R
		if( @ゆりをオカズにした１ == 1 )		// k-takahashi ぶら下がりで落ちた場合のみ回想ＣＧはさみます
		{
			@回想開始スタック
			@fade(bg_siro, 2)
			@cg1(evcm_1101, 2)
		}
		else
		{
			@bs
		}
		
		"一瞬间，记忆全部复苏了。"R //一瞬にして、記憶が蘇る。R
		
		if( @ゆりをオカズにした１ == 1 )
		{
			@fade(bg_siro, 2)
			@回想終了スタック
		}
		
		@縦揺れ_弱
		
		【@音無】"「呜哇啊啊啊啊啊啊啊———！！」"R //「うわあああぁぁぁぁーーー！！」R

		IF(@ゆりをオカズにした１==1){

			@bs(hn0403)
			KOE(000400050,010)【@日向】"「你一边喷着鼻血一边掉下去的样子，我也看到了」"R //「お前が鼻血をまき散らしながら落ちていく姿も俺は確認した」R

		}

		@bs(hn0408)
		KOE(000400055,010)【@日向】"「所以，你到底是发生了什么啊…」"R //「さて、お前に何があったのだろう…」R

		@bs
		
		"实在是天大的失态…。大脑一片空白。"R //なんて、大失態…。頭が真っ白になる。R
		"明明是在那种状况下，我却对由理…对由理…。"R //あんな状況なのに、俺はゆりに…ゆりに…。R
		"………。"R //………。R
		"……。"R //……。R

		@@選択=SELBTN(@selbtn_s_2,
			"引以为戒", //戒めを架す,
			"装傻充愣" //しらばっくれる
		)@selbtn_log
		if(@選択==1){

			"嘛，也不是什么大事。"R //まぁ、別にいっか。R

			【@音無】"「先不提这个了，去吃早饭了」"R //「そんなことより、朝飯に行こうぜ」R

			@bs(hn0107)
			KOE(000900960,010)【@日向】"「哦，好…」"R //「お、おう…」R

			GOTO #ASA_OWARI

		}
		"冷静下来之后，我向日向提出了一个请求。"R //冷静になってから、俺は日向にすがるようにお願いする。R
		
		【@音無】"「那个，日向，从现在开始，能不能叫我『只是个色批少年』？」"R //「なあ、日向、これから俺のことはただのエロ少年と呼んでくれないか」R
		
		@bs(hn0402)
		KOE(000400065,010)【@日向】"「我又没有要责怪你的意思哦？」"R //「責めてるわけじゃないぜ？」R
		【@音無】"「没有，只是这样的话，我就能时刻警醒自己，提醒自己要以战线成员的身份努力…」"R //「いや、そうすれば、常に戒めとなり、戦線のメンバーとして頑張れそうな気がするんだ…」R
		【@音無】"「否则的话，我…感觉要坚持不下去了…」"R //「でないと、俺…やっていける気がしない…」R
		
		@bs
		
		"我跪倒在了地板上，叩了一个响头。"R //倒れ込むように、額を床につけた。R
		
		@face(hn0107)
		//	チェックシート修正。ボイスに合わせてセリフ修正		西村
		//KOE(000400069,010)【@日向】「お前、そこまで思い詰めて…」R
		KOE(000400069,010)【@日向】"「你真要把自己逼到这种地步吗…」"R //「お前、そこまで追い詰めて…」R
		【@音無】"「拜托了！」"R //「頼む！」R
		
		@face(hn0101)
		KOE(000400071,010)【@日向】"「唉…」"R //「ふぅ…」R
		
		@bs(hn0202)
		KOE(000400072,010)【@日向】"「知道了。那么，我会称你为只是个色批少年的」"R //「わかった。呼ぶよ、お前をただのエロ少年と」R
		
		@bs(hn0404)
		KOE(000400073,010)【@日向】"「所以，只是个色批少年，赶紧洗个脸换个衣服，去吃早餐吧」"R //「じゃあ、ただのエロ少年、さっそく顔洗って着替えて、朝食食いにいこうぜ」R

		@あだ名フラグクリア
		@音無をただのエロ少年と呼ぶ=1
		@今あだ名である=1

		@音無_呼び方 = @ただのエロ少年と呼ぶ

		【@音無】"「嗯！」"R //「ああ！」R
		
		@音無称号(@ただのエロ少年と呼ぶ)
		@実績チェック
		
		@bs
		@timewaitkey(300)
		//GOTO #CHOUSYOKU

	}else{

		@bs(hn0103)
		KOE(000400083,010)【@日向】"「最好还是不要去在意这种事情。当成噩梦忘掉就行了。在这个世界里就得这样」"R //「そんなことは考えなくていい。悪い夢は忘れるこった。この世界ではな」R
		【@音無】"「作战成功了吗…？」"R //「オペレーションは成功したのか…？」R

		#AAYURIPPE
		
		@bs(hn0102)
		KOE(000400088,010)【@日向】"「嗯，多亏了游离子啊」"R //「ああ。ゆりっぺのおかげでな」R
		
		@bs(hn0109)
		KOE(000400089,010)【@日向】"「只是，Guild要从零重新开始了」"R //「ただ、ギルドは０からの再出発になっちまったけど」R
		【@音無】"「诶…什么意思？」"R //「え…どういう意味だ？」R
		
		@bs(hn0201)
		KOE(000400091,010)【@日向】"「嘛，以后补给弹药会比以前慢一些。仅此而已」"R //「まあ、ちっと銃弾の補填がこれまでより遅くなる。それだけのことさ」R
		【@音無】"「但是…」"R //「でも…」R
		
		@bs(hn0403)
		KOE(000400093,010)【@日向】"「没关系的。完全没有问题哦」"R //「大丈夫。何も問題はねーよ」R
		【@音無】"「这样吗…那就好…」"R //「そっか…ならいいけど…」R
		
		@bs(hn0404)
		KOE(000400095,010)【@日向】"「那就赶紧起来，洗个脸换个衣服，去吃完早餐就有精神了」"R //「だからとっとと起きて、顔洗って着替えろよ。朝食食ったら、元気になるさ」R
		【@音無】"「嗯」"R //「ああ」R
		
		IF(@野田との訓練全身刻まれた){

			@bs
			
			"我坐了起来，活动了一圈身体，发现完全没有疼痛感。身上的伤已经完全痊愈了。"R //体を起こして、軽く体操してみても痛みはない。怪我は完全に治っていた。R

			@野田との訓練全身刻まれた=0
		}

	}

//	GOTO #BEDKARA

}else{	// if(@ギルド降下作戦で生き残った==1){		// 最初の分岐３

	IF(@さらにホモ疑惑){

		@bg_pan_zd(ep99_bg001, 0, 300, 2)
		@timewaitkey(300)
		@pcmch_play(0, @起きるベッド)
		@縦揺れ_弱
		
		【@音無】"「哈！！」"R //「はっ！！」R
		"我猛地惊醒了。"R //飛び起きた。R
		
		@bgm_play(m301)		;;♪日常曲（朝の寮の部屋など）
		;;@bgm_play(m106)		;;■体験版用日常曲（朝の行動時）

		@pcmch_stop(1, 1000)

		@bs(hn0103)
		KOE(000400036,010)【@日向＿重複】"「哟，醒了吗」"R //「ようっ、起きたか」R
		
		@bs
		
		"我确认了一下身体。"R //俺は体を確かめる。R
		"制服依然穿在身上，完全没有变得凌乱。"R //制服を着たままだ。着崩れはしていない。R
		"那里也直接用手确认了一下，并没有什么痕迹。"R //アソコも直に触れてみたが、痕跡のようなものはない。R
		
		@bs(hn0107)
		KOE(000400119,010)【@日向】"「你在干什么？」"R //「何してんだ？」R
		【@音無】"「没什么，虽然你是同性恋，但我的身体并没有异样，于是松了口气」"R //「いや、お前がホモなのに、俺の体が無事だったことに安堵している」R
		
		@bs(hn0306)
		@横揺れ_弱
		
		KOE(000400121,010)【@日向】"「所以说，我不是同性恋啊——！！」"R //「だから、ホモじゃねええぇぇーー！！」R
		"虽然他拼命地否定着，但是我可不信…。"R //必死に否定するが、信じられない…。R
		
		@bs
		
		"不过，在经历昨晚的事情之后，我更加切实地感觉到，自己是死后世界战线这个组织的一员了…。"R //しかし、夕べは改めて、死んだ世界戦線という組織の一員であることを実感させられた…。R
		【@音無】"（就算是能无限续命，感觉也不够用啊…）"R //（いくら命があっても足りないレベルだ…）R
		
		@bs(hn0402)
		KOE(000400125,010)【@日向】"「别在那发呆了，赶紧洗个脸换个衣服，去吃早饭吧」"R //「いつまでも呆けてないで、とっとと顔洗って着替えろよ。朝食食いにいくぜ」R
		【@音無】"「…嗯」"R //「…ああ」R
		

		@AB03日向をホモ呼ばわり=1

		//GOTO #BEDKARA

	}else{

		@bg(ep99_bg001, 143)
		
		@bgm_play(m301)		;;♪日常曲（朝の寮の部屋など）
		;;@bgm_play(m106)		;;■体験版用日常曲（朝の行動時）

		"昨晚几乎没怎么睡着。"R //昨夜はあまり眠れなかった。R
		"昨天经历的那些事情完全无法挥之脑后，只要回想起来，就如同被梦魇惊扰一样反复惊醒，就这么一直持续到了早上。"R //昨日体験したことが未だ忘れられず、思い出してはうなされるように起きる、を朝まで繰り返していた。R

		IF(@ギルドに居続けた==0){

			【@音無】"（怎么说呢…这里可是日本，又不是美国那种枪战社会，这么随随便便地就到处开枪真的没问题吗…）"R //（なんていうか…アメリカのように銃社会でもない日本で、こんなにも簡単に銃を撃ちまくってもいいものなのかと…）R

		}

		//IF(@夜に入隊決めた==0){

			"明明第一天就体验过了这种事情，但实在是过于宏大了，反而变成了像梦境一样飘渺的记忆…。"R //それは初日に体験していたはずなのだけど、あれは壮大すぎて夢のような記憶になってしまっていて…。R

		//}

		"我更加切实地感觉到，自己是死后世界战线这个组织的一员了…。"R //改めて、死んだ世界戦線という組織の一員であることを実感させられた…。R
		
		@pcmch_stop(1, 1000)

		@bs(hn0207)
		KOE(000400149,010)【@日向】"「哦，抱歉，吵醒你了吗？」"R //「お、わり、起こしちまったか？」R
		"正在打理自己的日向担心地问道。"R //身支度をしていた日向が気遣うように言ってきた。R
		【@音無】"「没，不用在意。本来就是该起床的时间了吧」"R //「いや、気にすんな。いつも通りの時間だろ」R
		
		@bs(hn0102)
		KOE(000400152,010)【@日向】"「嗯，不过你昨天往床上一倒就睡过去了，所以我还打算让你多睡一会儿的」"R //「ああ、だけど、昨日お前、ぶっ倒れるようにして寝たからさ、もう少し寝させてやろうかと思って」R
		"他竟然这么为我着想吗…。"R //俺の様子をみて、配慮してくれたのか…。R

		IF(@０１日気がある){

			【@音無】"「谢了。不过还是要说，早上好」"R //「ありがとう。でも今は、おはようだ」R
			
			@bs(hn0104)
			KOE(000400158,010)【@日向】"「是啊，早上好」"R //「だな。おはよ」R
		
		/* k-takahashi ↓この前のifで引っかかってしまうので、ここにくることはありません
		}elseif(@さらにホモ疑惑){

			"が、無言のまま引いてしまう…。"R //が、無言のまま引いてしまう…。R
		*/
		}

		@bs(hn0404)
		KOE(000400167,010)【@日向】"「那就起来洗个脸换个衣服，去吃早饭吧」"R //「じゃ起きて顔洗って着替えろよ。朝食食いにいこうぜ」R
		【@音無】"「嗯」"R //「ああ」R

	}

}


