			KOE(000402007,010)【@日向】"「那是当然啊。可不要小看你的室友哦？」"R //「そりゃ、当然。ルームメイトを舐めるなよ？」R
		
		}
		
		【@音無】"「但是，我好像被她讨厌了…」"R //「でも、俺は嫌われているようなんだ…」R
		
		//@face(hn0401)
		@face(hn0103)
		KOE(000402009,010)【@日向】"「嗯，我也已经看出来了」"R //「ああ、それもわかってる」R
		【@音無】"「是吗…」"R //「だったのか…」R
		【@音無】"「我该怎么办？」"R //「俺はどうしたらいい？」R
		
		//@face(hn0402)
		@face(hn0102)
		KOE(000402012,010)【@日向】"「这个世界的时间是无限的。总有一天，你能创下某种壮举，让游离子对你刮目相看的」"R //「この世界は無限に続く。いつかでかい快挙を成し遂げて、ゆりっぺに気に入られる日も来るはずさ」R
		【@音無】"「这可不是几天或者几个月能做到的事情吧？」"R //「それは、数日や、数ヶ月の話じゃないんだろ？」R
		
		//@face(hn0407)
		@face(hn0109_01)
		KOE(000402014,010)【@日向】"「当然。几十年都有可能」"R //「もちろん。数十年はかかるだろうな」R
		
		@縦揺れ_弱
		
		【@音無】"「数十年！！」"R //「数十年！！」R
		
		@face(hn0101_09)
		KOE(000402016,010)【@日向】"「嘘————…」"R //「しーーーっ…」R
		"他提醒我压低声音。"R //声を潜ませる注意が来る。R
		【@音無】"「但是…几十年…这也太漫长了…」"R //「でも…数十年って…途方もなさ過ぎる…」R
		;－－－●以下、他のところで一緒のこと言っている気がする…
		
		@face(hn0101)
		KOE(000402020,010)【@日向】"「你看野田，在你之前很久就已经迷上游离子了，但是过了好几十年，也还是一点进展都没有哦？」"R //「野田だって、お前よりずーっと先にゆりっぺに惚れ込んでいるけど、何十年経っても、なんの進展もないんだぜ？」R
		
		@縦揺れ_弱
		
		【@音無】"「好几十年！！」"R //「何十年！！」R
		
		@face(hn0108)
		KOE(000402022,010)【@日向】"「都说了别喊了…」"R //「だから、叫ぶなってのっ…」R
		【@音無】"「但是，这只能说明野田不是由理喜欢的类型吧？」"R //「でも、それは野田がゆりのタイプじゃないだけじゃ？」R
		
		@face(hn0103)
		KOE(000402024,010)【@日向】"「她对谁都一样的。你选错目标了。要是把目标换成GDM成员之一的话，反而会更easy一些哦」"R //「誰に対してもそうだよ。相手が悪かったな。まだガルデモメンバーのほうが攻めるにはイージーな気がするぜ」R

		@AB03音無ゆりが好きと日向に伝えた=1

		@@選択=SELBTN(@selbtn_l_2,
			"由理才是真爱", //ゆりじゃなきゃ駄目だ,
			"还是忘掉由理，考虑GDM成员吧" //ゆりを忘れ、ガルデモメンバーの中で探してみる
		)@selbtn_log
		IF(@選択==0){		// (只有由理才是真爱/考虑GDM成员吧) 只有由理才是真爱

			【@音無】"「只有由理才是真爱…」"R //「ゆりじゃなきゃ駄目だ…」R
			
			@face(hn0107)
			KOE(000402035,010)【@日向】"「看来你已经爱到深处了啊…已经能和野田平起平坐了…」"R //「すげー惚れてんだな…野田とタメ張るレベルだぜ…」R
			【@音無】"「真的是无法实现的恋爱吗？」"R //「叶わぬ恋なのか？」R
			
			@face(hn0108)
			KOE(000402037,010)【@日向】"「虽然我已经和那家伙度过了很长的一段岁月，但是我也只能说，绝对没有机会」"R //「長い年月、あいつと一緒に過ごしてきたけど、ぜってー叶わねーな」R
			"好残忍的话…。"R //あまりに辛辣な言葉…。R
			
			@bgm_stack
			@bgm_play(m118, 2000)
			@bg(ep99_bg004, 2)
			@pcmch_play(0, @枕殴る)
			@縦揺れ_弱
			
			【@音無】"「可恶！」"R //「くっそ！」R

			@pcmch_play(0, @枕殴る連打)
			@縦揺れ_強
			
			【@音無】"「可恶可恶可恶啊啊啊啊啊啊————！！」"R //「くそくそくそおぉぉぉぉぉーーーっ！！」R
			
			"我爬了起来，一个劲儿地砸着枕头。"R //起き上がり、枕を叩きまくる。R
			
			@bg(ep99_bg003, 1)
			@bs(hn0106)
			KOE(000402042,010)【@日向】"「喂，住手吧！我会帮你想想办法的」"R //「よせ、やめろ！　俺が何か策を練るからさっ！」R
			@pcmch_stop(0, 500)
			"听到这句话之后…我平静了下来。"R //その言葉で、ふぅ…と落ち着く。R
			【@音無】"「具体是什么办法呢…」"R //「具体的に、どうやってだ…」R
			
			@bs(hn0109)
			KOE(000402045,010)【@日向】"「虽然现在还没想到…。但是，我会去尽快想办法的。在那之前请稍微忍耐一下…」"R //「それはまだ浮かんでいない…。でも、ちょいと俺が動いてみるから、それまで我慢してくれ…」R
			【@音無】"「嗯，抱歉…并且谢谢了…」"R //「ああ、すまん…ありがとう…」R
			
			//@bs(hn0504)
			@bs(hn0104)
			KOE(000402047,010)【@日向】"「不，照顾新人也是我的职责之一，完全没必要客气」"R //「いや、そういうのも新米に対して俺の役目さ、遠慮はいらねーよ」R
			【@音無】"「你真可靠…那就交给你了…」"R //「なんて頼もしい…任せるよ…」R
			
			//@bs(hn0402)
			@bs(hn0102)
			KOE(000402049,010)【@日向】"「好」"R //「ああ」R
			
			@bgm_pop_play(2000)
			//@bs(hn0407_04)
			@bs(hn0209_04)
			KOE(000402050,010)【@日向】"「呼啊…那么，我睡了…」"R //「ふわぁ…じゃ、寝るな…」R
			
			【@音無】"「嗯，晚安」"R //「ああ、おやすみ」R
			
			//@bs(hn0402)
			@bs(hn0102)
			KOE(000402052,010)【@日向】"「晚安…」"R //「おやすみ…」R
			
			@bs
			@timewaitkey(300)
			@pcmch_play(0, @照明スイッチ)
			@bg(ep99_bg004, 2)

			@ゆりへの思い日向がなんとかしてくれる=1

			GOTO #SYUUSHIN2

		}ELSE{	//IF(@選択==1){		// (只有由理才是真爱/考虑GDM成员吧) 考虑GDM成员吧

			【@音無】"「………」"R //「………」R
			"我烦恼了一会儿。"R //しばらく悩んだ。R
			"结论是。"R //その結果。R
			【@音無】"「知道了…我会忘掉由理，考虑一下GDM成员的」"R //「わかった…ゆりのことは一旦忘れ、ガルデモメンバーで考えてみる」R
			
			@face(hn0102)
			KOE(000402064,010)【@日向】"「嗯，很明智的决定」"R //「ああ、賢明な判断だ」R
			
			@face(hn0101)
			KOE(000402050,010)【@日向】"「呼啊…那么，我睡了…」"R //「ふわぁ…じゃ、寝るな…」R
			【@音無】"「嗯，晚安」"R //「ああ、おやすみ」R
			
			@face(hn0101)
			KOE(000402052,010)【@日向】"「晚安…」"R //「おやすみ…」R
			
			@pcmch_play(0, @照明スイッチ)
			@bg(ep99_bg004, 2)
			
			【@音無】"（GDM的成员吗…）"R //（ガルデモメンバーでか…）R
			"我在入睡之前想了想。"R //眠る前にだけ考えてみる。R
			
			//	一つ分岐を追加して、else以降を新設しました		西村
			IF(@岩沢からバンメン紹介受けている){
			
				"如果以由理作为满分理想型的话，虽然我只通过介绍了解过她们，但是已经可以排除掉关根和入江了。"R //俺の好みがゆりを頂点とするなら、バンメン紹介でしか会っていないが、関根や入江はない。R
				"剩下的只有岩泽和久子了…。"R //残るは岩沢とひさ子だが…。R

				@@選択=SELBTN(@selbtn_s_2,
					"岩泽", //岩沢,
					"久子" //ひさ子
				)@selbtn_log
				IF(@選択==0){		// (岩沢/ひさ子) 岩沢

					IF(@岩沢とはもう会えない==1){

						"但是，已经不能再和岩泽见面了…。"R //だが、岩沢とはもう会えない…。R

						IF(@ひさ子と会ったが無理をしなかった==0){

							"不过，还是可以和久子见面的。"R //でも、ひさ子なら、まだ会える。R
							"好，明天就去和久子见面吧。"R //よし、明日はひさ子に会いに行こう。R

							@消去法で選んだ=1
							@AB03ひさ子に会いにいくことにする=1

							GOTO #SYUUSHIN2

						}else{		// (@ひさ子と会ったが無理をしなかった==1)の場合

							"久子也已经被我惹怒了，也不可能去见她…。"R //ひさ子にも怒られてしまったし、会いに行けない…。R

						}

					}else{		// (@岩沢とはもう会えない==0)の場合

						"好，明天就去和岩泽见面吧。"R //よし、明日は岩沢に会いにいこう。R

						@AB03岩沢に会いにいくことにする=1

						GOTO #SYUUSHIN2

					}

				}ELSE{ //IF(@選択==1){		// (岩沢/ひさ子) ひさ子

					IF(@ひさ子と会ったが無理をしなかった==0){

						"好，明天就去和久子见面吧。"R //よし、明日はひさ子に会いに行こう。R

						@AB03ひさ子に会いにいくことにする=1

						GOTO #SYUUSHIN2

					}else{		// (@ひさ子と会ったが無理をしなかった==1)の場合

						"久子已经被我惹怒了，不可能去见她…。"R //ひさ子にも怒られてしまったし、会いに行けない…。R

						IF(@岩沢とはもう会えない==0){

							"但还是可以和岩泽见面的。"R //岩沢なら、まだ会える。R
							"好，明天就去和岩泽见面吧。"R //よし、明日は岩沢に会いに行こう。R

							@消去法で選んだ=1
							@AB03岩沢に会いにいくことにする=1

							GOTO #SYUUSHIN2

						}

					}		// IF(@ひさ子と会ったが無理をしなかった==0) のケツ

				}		// (岩沢/ひさ子) 選択処理のケツ

			}else{		// (@岩沢からバンメン紹介受けている==0)の場合
			
				"但真说起GDM成员们，我连她们的长相和姓名都一无所知…。"R //ガルデモメンバーと言われても、よく考えたら顔も名前も知らない…。R
				"唯一认识的只有岩泽，但是也没和她说过什么话。"R //唯一知っているメンバーは岩沢だが、その岩沢ともまともに話したことはない。R
				"这种状况下，完全无法把注意力从由理的身上移开…。"R //こんな状態じゃ、俺の心をゆりから他に向けるなんて不可能だ…。R
			
			}

			【@音無】"（GDM成员们是不可能了吗…）"R //（ガルデモメンバーじゃ駄目じゃん…）R
			"我陷入了绝望…。"R //絶望する…。R
			@ガルデモメンバーは駄目だった=1

			GOTO #SYUUSHIN2

		}		// (ゆりじゃなきゃ駄目だ/ガルデモメンバーの中で探してみる) 選択処理のケツ

		;－－－■■＠■■使用していない＆通れないフラグです。確認後削除します。（角）　おれにはよくわからないけど任せる（前田
		;		@ガルデモメンバーで考えてみる=1

	}		// (ゆりについて話をさせてくれ/このまま眠る) ゆりについて話をさせてくれの処理ケツ

}		// if(@ゆりから釘を刺された上追い出される==1)||(@ゆり浮ついたら死よりも恐い罰==1)判定のケツ

@pcmch_stop_all

@pcmch_play(0, @照明スイッチ)
@bg(ep99_bg004, 2)

//	文章微調整		西村
//日向も立ち上がり、部屋の電気を消す。R
"日向爬了起来，关掉了无力的电灯。"R //日向が立ち上がり、部屋の電気を消す。R

@face(hn0101)
KOE(000402155,010)【@日向】"「晚安」"R //「おやすみ」R
【@音無】"「嗯，晚安」"R //「ああ、おやすみ」R
"我们回到了各自的床上，坠入了梦乡。"R //それぞれ、ベッドへ入り、就寝した。R

#SYUUSHIN2


