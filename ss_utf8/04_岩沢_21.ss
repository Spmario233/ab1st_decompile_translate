@bs(iw0109_08)
KOE(040004924,004)【岩沢】"「不，现在是在作词。曲子已经写好了」"R //「いや、今は作詞だよ。曲は出来てる」R
【@音無】"「我不太了解音乐的事情。作词是在作曲之后进行的吗？」"R //「よくわかんねーけど、歌詞は後から書くもんなんだな」R

@bf(iw0208)
KOE(040004928,004)【岩沢】"「这种事情因人而异吧。我从来都是从作曲开始。知道为什么吗？」"R //「それは人それぞれ。あたしは、絶対に曲から書く。どーしてかわかるか？」R


@@選択=SELBTN(@selbtn_s_2,
	"知道", //わかる,
	"不知道" //わからない
)@selbtn_log
IF(@選択==0){		// (わかる/わからない) わかる

	【@音無】"「知道」"R //「わかる」R
	
	@bf(iw0201_08)
	KOE(040004937,004)【岩沢】"「哦，很厉害啊。具体是因为什么呢？」"R //「ほぅ、だとしたらすごいな。理由は？」R

	@@選択=SELBTN(@selbtn_m_3,
		"你不擅长作词", //作詞が苦手だから,
		"歌词要顾及编曲", //アレンジ次第だから,
		"你其实更喜欢器乐乐队" //本当はインストバンドが好きだから
	)@selbtn_log
	IF(@選択==0){		// (作詞が苦手だから/アレンジ次第だから/本当はインストバンドが好きだから) 

		【@音無】"「因为你不擅长作词，吗？」"R //「作詞が苦手だから、とか？」R
		;－－－★★★★修正
		//	▼▼ボイスに合わせてこちらをコメントアウトしておきました▼▼		西村
