@bg(ep88_bg007, 25)	;－－－□空き教室

IF(@０１日日向から岩沢の行動パターン聞いた){

	"我透过窗户向里面张望着。"R //窓越しに覗き込む。R
	
	@bg(ep03_bg015)
	@cinema_bs(bs2_iw0101_09, 3, 200)
	@timewaitkey(1000)
	
	"确实和日向说的一样。"R //日向から聞いていた通りだ。R
	"岩泽正一边哼着歌，一边弹奏着一把木吉他。"R //岩沢が鼻歌を歌いながら、アコースティックギターをつま弾いていた。R
	"偶尔会本子上动笔写些什么。"R //たまに、ノートにペンを走らせる。R
	"她似乎是把木吉他带到了空教室，一个人在作曲。"R //空き教室でひとり、アコースティックギターを持って、作曲のご様子。R

}else{

	// ■■■■ 前触れ無くいきなり選択肢からとか冗談にもなってないので、テキストを（西
	"我来到了一间空教室前。"R		//■■■■たした（あまの） //空き教室へと足を運ぶ。R		

	@bg(ep03_bg015)
	@cinema_bs(bs2_iw0101_09, 3, 160)
	@timewaitkey(1000)
	
	// k-takahashi ↓さらに足しました
	"岩泽正一边哼着歌，一边弹奏着一把木吉他。"R //岩沢が鼻歌を歌いながら、アコースティックギターをつま弾いていた。R
	"偶尔会本子上动笔写些什么。"R //たまに、ノートにペンを走らせる。R
	// k-takahashi ↑
}

@@選択=SELBTN(@selbtn_s_2,
	"和她说话", //話しかけてみる,
	"放着她不管" //そっとしておく
)@selbtn_log
IF(@選択==1){

	@sc_cinema_off
	@bs_wipe_type(2)
	@bs

	IF(@０１日日向から岩沢の行動パターン聞いた){

		"还是听日向的话，不要打扰她了…。"R //日向に言われた通り、邪魔はしないでおくか…。R

	}else{

		"还是不打扰她了，让她一个人继续吧。"R //邪魔になるだろう。そっとしておこう。R

	}
	
	@fade(bg_kuro, 25)
	
	"我离开了这里。"R //その場を立ち去った。R

	;;@01で岩沢と会話せず立ち去った=1	;;不要フラグ（魁

	@岩沢ＭＡＰ非表示=1	;;これが立つと、岩沢はもうＭＡＰに現れない

	goto #OWARIZ01

}

