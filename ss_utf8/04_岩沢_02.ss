	"把这里交给关根发挥吧" //そこは関根に任せたほうがいい
)@selbtn_log
IF(@選択==0){		// (ライブが始まるぞーー！！/そこは関根に任せたほうがいい/立ち去る) 
	
	@縦揺れ_弱
	
	【@音無】"「演唱会开始了哦——！！」"R //「ライブが始まるぞーー！！」R
	
