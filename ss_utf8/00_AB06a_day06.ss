	}
}else{
	KOE(000800381,010)【@日向】"「该起床咯，音・无・同・学！」"R //「そろそろ起きろよー、お・と・な・し！」R
}

//#UWAOO

@bgm_play(m301)		;;♪日常曲（朝の寮の部屋など）

