	"逃跑" //逃げる
)@selbtn_log
IF(@選択==0){		// (干了它/逃跑) 干了它

	"真的要…这么做吗…。"R //マジかよ…俺…。R

	#FURUERUTEDE
	
	//@bg(ep88_bg013,252)
	//震える手で箸を使い、それを持ち上げ、口に運ぶ。途端、鼻に抜ける汚物臭！R	// 演出用にテキスト分割
	"我用颤抖的手拿起了筷子，把豆腐放到了嘴里。"R //震える手で箸を使い、それを持ち上げ、口に運ぶ。R
	
	@sc_nega(1)
	@bg(ep88_bg013,252)
	
	"恶心的臭味直接扑鼻而来！"R //途端、鼻に抜ける汚物臭！R
	
	@sc_nega(0)
	@bg(ep88_bg013,99)
	@quake_ud(100,1,3,150,0,0)
	
	【@音無】"「呜呕呃呃呃呃——————！！」"R //「うおえぇぇぇーーーーーー！！」R
	"简直要吐了。"R //吐きそうになる。R
	
	@bs(fj0504)
	KOE(990301321,013)【藤巻】"「虽然很臭，但是很美味吧？」"R //「臭いけど、美味しいだろ？」R
	
	@横揺れ_弱
	
	【@音無】"「才不美味啊！！」"R //「美味しくねぇーよっ！！」R
	
	@bs
	
	"我狼吞虎咽地塞了点米饭和味噌汤进嘴，然后到此为止了。"R //ご飯と味噌汁だけを掻き込み、ごちそうさんをする。R

	@bs(fj0107)
	
	【@音無】"「再见了」"R //「じゃあな」R
	
	@bs(fj0106)
	KOE(990301325,013)【藤巻】"「喂喂…」"R //「おいおい…」R
	
	@bgm_stop(2000)
	@fade(bg_kuro,25)
	
	"我甩开了还在吃饭的藤卷，离开了食堂。"R //まだ食事中の藤巻を残して、立ち去る。R

	@揚げ臭豆腐定食食べた=1
	@食券揚げ臭豆腐定食=1
	@実績チェック

}ELSE{	// IF(@選択==1){		// (干了它/逃跑) 逃跑

	@bs(fj0107)
	
	【@音無】"「让给你吃了！」"R //「お前に譲る！」R
	
	@bs(fj0106)
	KOE(990301333,013)【藤巻】"「诶！？」"R //「え！？」R
	
	@bgm_stop(2000)
	@fade(bg_kuro, 24)
	
	"我把它推给了藤卷，从食堂里逃了出去。"R //藤巻に押しつけて、俺は食堂から逃げ出した。R

	@揚げ臭豆腐定食から逃げた=1

}

close
@bgm_play(m120, 1000)
@bg_pan_du(ep04_bg047)
@timewaitkey(1000)

【@音無】"（空气竟然能如此美味…）"R //（空気ってこんな美味しかったんだ…）R
"我走到了外面，才意识到这小小的幸福。"R //外に出て、そんなささやかな幸せに気づく。R

IF(@岩沢と個人的に会えなくなる==1){

	"如此强烈的经历，已经足以让我忘记不能再和岩泽见面的事情了。"R //岩沢と個人的に会えなくなったことも、忘れられるほど、強烈な出来事だった。R

	@藤巻のおかげで岩沢ショック回避=1

}		// (食べる/逃げる) 選択肢処理ケツ

"至少在这一点上一定要感谢藤卷…。"R //それだけは藤巻に感謝しなくちゃならない…。R




