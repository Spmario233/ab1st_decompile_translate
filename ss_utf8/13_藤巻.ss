// #SCENE_SCRIPT_ID = 1300 （スクリプトＩＤ：この行は削除したり、変更したりしないで下さい）

;;藤巻用のシナリオです。飯を奢るときに使用。

#Z00


IF(@岩沢と個人的に会えなくなる){
	
	@bg(ep10_bg007, 25)
	
	"虽然没什么食欲，但我还是去了食堂。"R //食欲も湧かないけど、とりあえず食堂に向かう。R
	
	@移動(ep88_bg020)	;－－－□大食堂
	@bgm_play(m302)
	
	@bs(fj0501)
	
	"藤卷正站在食堂门口。"R //入り口に藤巻が立っていた。R
	
	@bs(fj0102)
	KOE(000501061,013)【藤巻】"「你来了啊，走吧」"R //「来たか。行くぜ」R
	【@音無】"「欸？」"R //「え？」R

	;;■■コメントアウト待避 18■■

	;－－－■■■■抜けの指摘があったので追加します（角）
	IF(@藤巻に昼食奢られる約束した){

		@bs(fj0110)
		KOE(000501079,013)【藤巻】"「约好了今天要请客的吧？你记不得了！？」"R //「明日は奢るって約束したろ？　忘れたってのか！？」R
		【@音無】"「抱歉，发生了一些震惊到我的事情…」"R //「すまん、ショックな出来事があってさ…」R

	}ELSE{		//■■■■こっちは３日目に日向と行動したときに発生（あまの）
		
		// k-takahashi メモ：2日までに @岩沢と個人的に会えなくなる を立てて、
		//					 3日目、日向と行動している場合に通れる分岐
		
		@bs(fj0303)
		KOE(000501084,013)【藤巻】"「那个，之前一直没来得及跟你讲，其实我本来想请你吃午饭的…所以我一直在等你」"R //「その、言いそびれちまったが、実は昼飯を奢ってやろうって思っててな…待っててやったんだよ」R
		【@音無】"「诶？为什么？」"R //「え？　何故？」R
		
		@bs(fj0509)
		KOE(000400806,013)【藤巻】"「呃…咋说呢…呃…就是那个…」"R //「ええと…なんつーか…ええと…アレだよ…」R
		"完全搞不明白他在说什么。"R //さっぱり何も伝わって来ない。R
		
		@bs(fj0507)
		KOE(000400808,013)【藤巻】"「那个就是那个…总之受你关照了…」"R //「アレがアレでさ…ようは世話になった…」R
		"我什么时候关照过藤卷吗？"R //いつ藤巻の世話などしたのだろう？R
		
		@bs(fj0509)
		KOE(000400810,013)【藤巻】"「看你的表情，是还没想起来啊…」"R //「まだわかってねーって面だな…」R
		【@音無】"「嗯，不具体说明的话，完全不清楚…」"R //「ああ。具体的に言ってもらわないと、さっぱりだ…」R
		
		@bs(fj0110)
		KOE(000400812,013)【藤巻】"「虽然最后我还是淹死了…。但你还是有在拼命地救我…」"R //「結果としては、俺は溺れた…。でもお前は必死で俺を助けようとしてくれた…」R
		"他这么一说，我才想起来水淹陷阱的事情。"R //そう言われて、ようやく水路のトラップでの出来事を思い出す。R
		【@音無】"「所以…？」"R //「それで…？」R
		
		@bs(fj0502)
		KOE(000400815,013)【藤巻】"「所以…现在不是大中午吗？」"R //「でって…ほら、今は昼休みだろ？」R
		【@音無】"「是啊」"R //「そうだな」R
		
		@bs(fj0503)
		KOE(000400817,013)【藤巻】"「所以，午饭，我请客」"R //「だから、奢ってやるよ、昼飯」R
		【@音無】"「………」"R //「………」R
		
		@bs(fj0105)
		KOE(000501099,013)【藤巻】"「怎么啦，果然还是觉得我碍事了吗！？」"R //「んだよっ、やっぱ迷惑だってか！？」R
		【@音無】"「不，我很高兴…抱歉，发生了一些震惊到我的事情…」"R //「いや、気持ちは嬉しいんだが…すまん、ショックな出来事があってさ…」R

	}
	
	@bs(fj0103)
	KOE(000501103,013)【藤巻】"「呵，那就更好了。必须得请你剋顿好的」"R //「へっ、なら尚更だな。いいもん食わせてやるよっ」R
	【@音無】"「谢了…」"R //「ありがたい…」R
	
	@fade(bg_kuro, 25)
	
	"我跟着藤卷走进了食堂。"R //藤巻に続いて、中に入る。R

	//GOTO #TOMUYAMUKAREE
	//@藤巻と昼飯=1		// （西	このssのreturn直前に移動しました（鈴木

}
else{

	IF(@藤巻に昼食奢られる約束した){

		@bg(ep10_bg007, 25)
