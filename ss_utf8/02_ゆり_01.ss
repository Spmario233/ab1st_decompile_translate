;;@０１日ゆりに会った=1


@pcmch_play(0, @木製ノック)//効果音（ドアノック音コンコンコン）

"我站到了作战总部的门口，敲了敲门。"R //本部の前に立ち、ドアをコンコンコンとノックする。R
"里面只传来了一句“说密码—”的回应。"R //中から、合い言葉ー、という声が返ってくる。R

@pcmch_stop(0, 500)

IF(@DAYS==1 && @０１日ひとりで行動==0){	;;１日目・日向と共に行動してる時限定
	@face(hn0403)
	KOE(020000012,010)【@日向】"「你还记得密码吧？」"R //「覚えてるよな？」R
	"我点了点头。"R //俺は頷く。R
}

;－－－●↓選択肢入れたいーー！！が自重
【@音無】"「无神无佛无天使」"R //「カミモホトケモテンシモナシ」R
@pcmch_play(0, @鍵開ける)//効果音（解錠）
"确认听到咔嚓的解锁声后，我走了进去。"R //がちゃり、と解錠される音を確認してから、中に入る。R
@pcmch_play(0, @木製扉開ける中)//効果音（本部扉開ける）

@bgs(ep01_bg057, yr0401_09, 151)

"屋里只有由理。"R //ゆりだけが居た。R

IF(@DAYS==1 && @０１日ひとりで行動==0){	;;１日目・日向と共に行動してる時限定 （魁

	@bs(yr0101_06)
	KOE(020000024,002)【@ゆり】"「哦，你们两位有什么事吗？」"R //「あら、ふたりしてどうしたのかしら？」R	// ここには1日目しか来られない
	【@音無】"「呃…」"R //「ええと…」R

	@@選択=SELBTN(@selbtn_m_3,
		// k-takahashi ↓ゆりのセリフに対してまだと言葉はおかしいので修正します
		//まだ質問がある,
		"我有个问题", //質問がある,
		"只是来见你", //お前に会いに来ただけ,
		"来秀一下我们的良好关系",(@０１日気がある||@その気さらにあり) //俺たちの仲の良さを見せつけにきた,(@０１日気がある||@その気さらにあり)
	)@selbtn_log
	IF(@選択==0){		// (まだ質問がある/お前に会いに来ただけ/俺たちの仲の良さを見せつけにきた) まだ質問がある
		
		// k-takahashi ↓修正しました
		【@音無】"「嗯，我有个问题」"R //「ああ、質問があるんだ」R
		GOTO #NANI
		//GOTO #MADSIT

	}ELSEIF(@選択==1){		// (まだ質問がある/お前に会いに来ただけ/俺たちの仲の良さを見せつけにきた) 

		GOTO #OAINI

	}ELSE{	// IF(@選択==2){		// (お前に会いに来ただけ/まだ質問がある/俺たちの仲の良さを見せつけにきた) 

		【@音無】"「来秀一下我们的良好关系」"R //「俺たちの仲の良さを見せつけにきた」R
		@bs(yr0107)
		KOE(001801429,002)【@ゆり】"「哈？」"R //「は？」R
		"我将左肘搭在了日向的右肩上，右手叉着腰，两个人整齐划一地缓缓鞠了一躬。"R //俺が日向の右肩の上に左肘をのせ、右手を腰につけながら二人そろってゆっくりお辞儀した。R
		"能够配合得如此默契，真不愧是日向啊。"R //息を合わせてくれた日向に感服する。R
		;@bs(yr0405)
		@bs(yr0112_05)
		@横揺れ_弱
		KOE(020000049,002)【@ゆり】"「" @注(@COWCOW) "————！！」"R //「ＣＯＷＣＯＷーーーー！！」R
		@清除注释
		@bs_add(hn0207,6)
		KOE(020000050,010)【@日向】"「欸？什么？扣扣…？」"R //「え？　何？　かうかう…？」R
		【@音無】"（明明不知道，却还是做到了吗…好厉害啊，日向…）"R //（知らずに出来たのか…すごいな、日向…）R
		@bf(yr0609)
		KOE(020000052,002)【@ゆり】"「总之，我知道你们关系很好了。还有别的事吗？」"R //「とにかく、仲がいいのはわかったわ。他に用は？」R
		【@音無】"「没什么了」"R //「特にない」R
		@bf(hn0309_07)
		KOE(020000054,010)【@日向】"「欸？没别的事了吗！？」"R //「え？　もういいの！？」R
		【@音無】"「嗯。已经达到目的了」"R //「ああ。目的は済んだ」R
		@bf(yr0608)
		KOE(020000056,002)【@ゆり】"「以后别再为了这点事特意过来了」"R //「二度とこんな用で来ないでね」R
		@bf(hn0109)
		KOE(020000057,010)【@日向】"「真是的…」"R //「まったくだぜ…」R
		@fade(bg_kuro, 25)
		"他们也许并不能理解我，但我很满足。"R //理解は得られなかったかもしれないけど、俺は満足だ。R
		"我怀着这份充实感，离开了总部。"R //充実感を抱きながら、退室した。R

		@カウカウポーズ取った=1

		goto #OWARIZ01				// ■■■■ どこか飛ばさないと下の選択肢に行くんでおかしいです（西　強制return（西

	}

}elseif(@DAYS==1){	;;▼▼▼１日目、一人で行動している場合▼▼▼

	@bs(yr0101)
	IF(@クソ坊主==1){
		KOE(020000066,002)【@ゆり】"「哎呀，小兔崽子君。还有什么别的问题吗？」"R //「あら、クソ坊主くん。まだ、質問かしら？」R
	}elseif(@代理人==1){
		KOE(020000068,002)【@ゆり】"「哎呀，代理人。还有什么别的问题吗？」"R //「あら、代理人。まだ、質問かしら？」R
	}elseif(@微妙すぎるイケメン==1){
		KOE(020000070,002)【@ゆり】"「哎呀，微妙的帅小伙君。还有什么别的问题吗？」"R //「あら、微妙すぎるイケメンさん。まだ、質問かしら？」R
	}elseif(@ロリコン==1){
		KOE(020000072,002)【@ゆり】"「哎呀，萝莉控君。还有什么别的问题吗？」"R //「あら、ロリコンくん。まだ、質問かしら？」R
	}elseif(@メガネ仲間==1){
		KOE(020000074,002)【@ゆり】"「哎呀，眼镜之友君。还有什么别的问题吗？」"R //「あら、メガネ仲間くん。まだ、質問かしら？」R
	}elseif(@暗算日本記録保持者==1){
		KOE(020000076,002)【@ゆり】"「哎呀，全日本珠心算记录保持者同学。还有什么别的问题吗？」"R //「あら、暗算日本記録保持者さん。まだ、質問かしら？」R
	}elseif(@通り魔==1){
		KOE(020000078,002)【@ゆり】"「哎呀，无差别杀人犯君。还有什么别的问题吗？」"R //「あら、通り魔くん。まだ、質問かしら？」R
	}elseif(@記憶ナシ男==1){
		KOE(020000080,002)【@ゆり】"「哎呀，没记忆的男人君。还有什么别的问题吗？」"R //「あら、記憶ナシ男くん。まだ、質問かしら？」R
	}elseif(@音速==1){
		KOE(020000082,002)【@ゆり】"「哎呀，音速君。还有什么别的问题吗？」"R //「あら、音速くん。まだ、質問かしら？」R
	}elseif(@音無==1){
		KOE(020000084,002)【@ゆり】"「哎呀，音无君。还有什么别的问题吗？」"R //「あら、音無くん。まだ、質問かしら？」R
	}elseif(@無限==1){
		KOE(020000086,002)【@ゆり】"「哎呀，无限君。还有什么别的问题吗？」"R //「あら、無限くん。まだ、質問かしら？」R
	}

	@@選択=SELBTN(@selbtn_s_2,
		"嗯，还有别的问题", //ああ、まだ質問がある,
		"只是来见你" //お前に会いに来ただけ
	)@selbtn_log
	IF(@選択==0){		// (ああ/お前に会いに来ただけ) ああ
		GOTO #MADSIT
	}
	GOTO #OAINI

}else{		;;もしくは２日目以降の場合
	
	@bs(yr0101)
	KOE(001011255,002)【@ゆり】"「哎呀，有什么事吗？」"R //「あら、どうしたの？」R
	
	@@選択=SELBTN(@selbtn_s_2,
		"我有个问题", //質問がある,
		"只是来见你" //お前に会いに来ただけ
	)@selbtn_log
	IF(@選択==0){		// (質問がある/お前に会いに来ただけ) 質問がある
		【@音無】"「嗯，我有个问题」"R //「ああ、質問があるんだ」R
		GOTO #NANI
	}
	
	// お前に会いに来ただけ
	GOTO #OAINI

}

//───────────────────────────────────────
//質問がある系
#MADSIT
	【@音無】"「嗯，我还有别的问题想问」"R //「ああ、まだ質問がある」R

	#NANI
	@bs(yr0101_06)
	KOE(020000098,002)【@ゆり】"「是什么？」"R //「何？」R
	【@音無】"（嗯…？虽然嘴上这么说，但根本就没有什么想问的问题啊…？）"R //（ん…？　ああ、と答えておきながら、まったく何も訊きたいことが浮かばないぞ…？）R
	【@音無】"（总之随便问点什么吧…）"R //（とりあえず、適当に訊くか…）R

	#SANTK1
	@@選択=SELBTN(@selbtn_s_3,
		"有什么爱好吗？", //趣味は？,
		"年龄多大了？", //年齢は？,
		"喜欢喜欢吃什么？" //好きな食べ物は？
	)@selbtn_log
	IF(@選択==0){		// (趣味は？/年齢は？/好きな食べ物は？) 

		//#SYUMI
		farcall(＿ゆり+"_00_ゆりのこと",01)
		//GOTO #SUMAN

	}ELSEIF(@選択==1){		// (趣味は？/年齢は？/好きな食べ物は？) 年齢は？

		farcall(＿ゆり+"_00_ゆりのこと",02)

	}ELSE{	// IF(@選択==2){		// (趣味は？/年齢は？/好きな食べ物は？) 好きな食べ物は？

		farcall(＿ゆり+"_00_ゆりのこと",03)

	}
	GOTO #OWARIZ01

//───────────────────────────────────────
//お前に会いに来ただけ
#OAINI
	【@音無】"「单纯只是想来见你而已，有什么问题吗？」"R //「お前に会いたかっただけだけど、問題あるか？」R
	@bs(yr0107)
	KOE(020000277,002)【@ゆり】"「为什么？」"R //「理由は？」R
	@@選択=SELBTN(@selbtn_s_2,
		"因为我对你有想法", //お前に気があるから,
		"因为你是战线的领袖" //戦線のリーダーだから
	)@selbtn_log
	IF(@選択==0){		// (お前に気があるから/戦線のリーダーだから) お前に気があるから

		@ゆりに気があると答えた=1

		【@音無】"「因为我对你有想法」"R //「お前に気があるから」R

		IF(@DAYS==1 && @０１日ひとりで行動==0){	;;１日目・日向と共に行動してる時限定
			@face(hn0106)
			@縦揺れ_弱
			KOE(020000290,010)【@日向】"「欸欸欸——！！明明你才刚到这个世界就！？」"R //「えぇぇーー！！　この世界に来てすぐなのに！？」R
			@bs
			"身后的日向吃惊地大喊着。"R //背後から日向の仰天する声が。R
			@bs(hn0306)
			KOE(020000292,010)【@日向】"「而且，对方还是游离子！？」"R //「しかも、相手がゆりっぺ！？」R
			【@音無】"「欸？不行吗？不仅长得漂亮，还是战线的领袖。不是很完美嘛」"R //「え？　駄目なのか？　美人で戦線のリーダー。完璧じゃないか」R
			"我转过身面向他，表达出了自己的想法。"R //振り返り訴える。R
			@bs(hn0108)
			KOE(020000295,010)【@日向】"「再好好考虑下吧…游离子绝对不行…」"R //「考え直せ…ゆりっぺはない…」R
			@bs_add(yr0610_03)
			KOE(020000296,002)【@ゆり】"「不行？这是什么意思啊，日向君？」"R //「ない？　それはどういう意味かしら、日向くん？」R
			@bf(hn0107_05)
			KOE(020000297,010)【@日向】"「诶诶！？我！？」"R //「ええっ！？　俺！？」R
			@bf(hn0209_07)
			KOE(020000298,010)【@日向】"「毕竟你从来都没有喜欢过谁，而且我们和你相处了这么多年以后，早就不把你当成女生看代了…」"R //「だって、お前が誰かを好きになることもないし、長年付き合ってきた俺たちからは、女として見られねーしさ…」R
			@bs(bs3_yr0105)
			@横揺れ_弱
			KOE(020000299,002)【@ゆり】"「给我闭上你那啰啰嗦嗦的臭嘴——！！」"R //「ごちゃごちゃうっさいなぁーー！！」R
			@bf(bs2_yr0303@00a)
			KOE(020000300,002)【@ゆり】"「好不容易才出现了一个能够注意到我的魅力的成员啊？」"R //「ようやくあたしの魅力に気づいてくれたメンバーが現れたのよ？」R
			@face(hn0407)
			KOE(020000301,010)【@日向】"「但他很快就不会再有这种想法了吧」"R //「でもすぐ、そんな気はなくなるだろーがな」R
			@bf(yr0205)
			@横揺れ_弱
			KOE(020000302,002)【@ゆり】"「说不定以后也还有呢————！！」"R //「なくならないかもしれないだろぉーーー！！」R
			@bs_add(hn0209_07, 6)
			KOE(020000303,010)【@日向】"「那么，游离子也对他有想法吗…？」"R //「じゃあ、ゆりっぺも、こいつにその気が…？」R
			@bf(yr0210)
			KOE(020000304,002)【@ゆり】"「没有」"R //「ないわ」R
			
			@bs
			@pcmch_play(0, @ガーン)//効果音（ショック）
			@横揺れ_弱
			
			【@音無】"「被甩了啊啊啊——！！」"R //「振られたあぁぁーー！！」R
			"我沮丧地耷拉着肩膀。"R //俺は肩を落とす。R

			@pcmch_stop(0, 500)

			@bs(hn0306)
			KOE(020000307,010)【@日向】"「不要再玩弄新人的内心了！！看他都失落成什么样了啊！！」"R //「新米をもてあそんでやるなよっ！　落ち込んじまったじゃねーか！！」R
			【@音無】"「算了，不用这么安慰我的，走吧…」"R //「いや、フォローとかもういいから、出よう…」R
			@bs(hn0101)
			KOE(020000309,010)【@日向】"「好吧…」"R //「だな…」R

			@０１日いきなりゆりに振られた=1

			goto #OWARIZ01

		}
		
		@bs(yr0506)
		KOE(020000317,002)【@ゆり】"「你还真行啊，才刚刚来到这个世界，就能对一个完全不了解的人如此坚定」"R //「よくもまあ、そんなことをこの世界に来てすぐ、まったく知らない相手に言い切れるものね」R
		@bs(yr0507)
		KOE(020000318,002)【@ゆり】"「到底是被我的哪里吸引了呢」"R //「一体、あたしのどこに惹かれたのかしら」R

		//#LOOKS
		@@選択=SELBTN(@selbtn_s_3,
			"外貌", //ルックス,
			"领袖能力", //リーダーシップ性,
			"不太清楚" //よくわからない
		)@selbtn_log
		IF(@選択==0){		// (ルックス/リーダーシップ性/よくわからない) ルックス/

			【@音無】"「因为，你很漂亮吧？」"R //「だって、お前、美人じゃん？」R
			@bs(yr0609)
			KOE(020000329,002)【@ゆり】"「也就是说，你喜欢我的外貌，是这个意思吧」"R //「ルックスがあなた好みだと、そういうこと？」R
			【@音無】"「嘛…算是…吧…」"R //「まあ…そういうことになる…かな…」R
			"被她本人面对面地这么问，感觉很不好意思…。"R //本人から直接訊かれると、さすがに気恥ずかしい…。R
			@bs(yr0410)
			KOE(020000332,002)【@ゆり】"「我说你啊…」"R //「あなたねぇ…」R
			"她原本冷静的表情逐渐变得愤怒了起来。"R //冷静だった顔が憤怒の色に変わる。R
			【@音無】"「欸欸！？」"R //「えぇ！？」R
			@bs(bs3_yr0107_05@00a)
			@横揺れ_弱
			KOE(020000335,002)【@ゆり】"「你是不是以为自己在玩什么Galgame啊，觉得可以到处随便轻浮！？」"R //「ギャルゲーでもプレイしている、そんな軽い気持ちでいるんじゃないの！？」R
			【@音無】"「才没有，我被天使刺杀过，也被野田砍杀过，早就清楚记住了死亡的痛苦，已经有了与此相应的觉悟哦？」"R //「いや、天使に刺されたり、野田に切り刻まれたり、死ぬ痛みも覚えたから、それなりに覚悟はあるぜ？」R
			@bs(yr0107)
			KOE(020000337,002)【@ゆり】"「你的生前记忆怎么样了？」"R //「あなた、生前の記憶は？」R
			【@音無】"「这个嘛…还是没想起来…」"R //「それは…まだ思い出せないでいる…」R
			@bs(bs2_yr0110@00a)
			KOE(020000339,002)【@ゆり】"「那至少等你找回记忆以后再谈」"R //「だったら、せめて、思い出してからにして」R
			【@音無】"「等我想起来之后，你也会认真考虑吗？」"R //「思い出したら、お前も真剣に考えてくれるのか？」R
			@bs(yr0508_09)
			KOE(020000341,002)【@ゆり】"「谁知道呢」"R //「さあね」R
			@bs
			"她将手肘支到了桌子上，把头扭向了一边。"R //机に肘をついて、そっぽを向く。R
			"真是冷淡啊。"R //なんとも冷たい。R
			【@音無】"「知道了」"R //「わかったよ」R
			
			@fade(bg_kuro, 25)
			
			"我离开了作战总部。"R //本部を後にした。R

			@０１日ゆりに気がある=1
			@ゆりに気がある=1

			//return

		}ELSEIF(@選択==1){		// (ルックス/リーダーシップ性/よくわからない) リーダーシップ性

			【@音無】"「被你的领袖能力」"R //「リーダーシップ性」R
			@bs(yr0609)
			KOE(020000355,002)【@ゆり】"「但我感觉还没在你的面前展露出来过呢」"R //「それはまだあなたの前では発揮していない気がするのだけど」R
			
			//	▼▼ギルド降下作戦の進行度合いによる分岐を設置▼▼		西村
			IF(@ギルド降下作戦で生き残った){
			
				【@音無】"「你在说些什么啊。由理你不管是在Guild空降作战的时候，还是在旧Guild发号施令的时候，都不折不扣地展露着领袖气质啊」"R //「何言ってんだよ。ギルド降下作戦の最中も、オールドギルドで指示出してるゆりも、紛れもないリーダーの姿だったぜ」R
			
			}elseif(@ギルド降下作戦の途中で死んだ==1||@ギルド降下作戦最下層に辿り着いて死んだ==1){
			
				【@音無】"「不不，你在Guild空降作战时带头冲锋的样子，就已经满溢着领袖气质了」"R //「いや、ギルド降下作戦で先陣切って進む姿は、リーダーシップに溢れてたぞ」R
			
			}else{
			
				【@音無】"「不不不，身为一个女生，却能够统率这么一群糙老爷们儿，光凭这一点就已经很厉害了」"R //「いやいや、女性であんなむさ苦しい連中を束ねてるなんて、すでにすげーと思うよ」R
			
			}
			//	▲▲分岐設置終了▲▲
			
			@bs(yr0608_09)
			KOE(020000357,002)【@ゆり】"「…嘛，我就接受你的夸奖吧」"R //「…まあ、褒め言葉として受け取っておくわ」R
			@bs(yr0109_06)
			KOE(020000358,002)【@ゆり】"「就这点事吗？」"R //「用はそれだけ？」R
			【@音無】"「嗯」"R //「ああ」R
			@bs(yr0109)
			KOE(020000360,002)【@ゆり】"「那么，你现在还只是个新人，就请你努力锻炼体力，练习枪法，争取追上其他干部吧」"R //「じゃあ、あなたはまだまだ新米なんだから、幹部のみんなに追いつくぐらい、体力作りと銃の練習に努めなさい」R
			【@音無】"「是啊…」"R //「だな…」R

		}ELSE{	// IF(@選択==2){		// (ルックス/リーダーシップ性/よくわからない) よくわからない

			【@音無】"「我还不太清楚…」"R //「よくわからない…」R
			@bs(yr0207)
			KOE(020000368,002)【@ゆり】"「那看来只是在浪费时间呢」"R //「それでよくこんな無駄な時間を過ごせるものね」R
			"无法反驳。"R //言い返す言葉もない。R
			@bs(yr0209)
			KOE(020000370,002)【@ゆり】"「请你努力锻炼体力，练习枪法，争取追上其他干部吧」"R //「幹部のみんなに追いつくぐらい、体力作りと銃の練習に努めなさい」R
			【@音無】"「是啊…」"R //「だな…」R

		}		// (ルックス/リーダーシップ性/よくわからない) 

		//GOTO #IIKARA

	}ELSE{	// IF(@選択==1){		// (お前に気があるから/戦線のリーダーだから) 戦線のリーダーだから

		【@音無】"「因为你是战线的领袖」"R //「戦線のリーダーだから」R
		@bs(yr0209)
		KOE(020000382,002)【@ゆり】"「那么，你有什么想问的吗？」"R //「じゃあ、何か訊きたいことでも？」R

		@ゆりが戦線のリーダーだから=1

		GOTO #SANTK1

	}		// (お前に気があるから/戦線のリーダーだから) 


#OWARIZ01

@fade(bg_kuro, 25)

return

