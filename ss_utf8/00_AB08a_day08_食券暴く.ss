//───────────────────────────────────────

"就是现在…。"R //ここは…。R

@@選択=SELBTN(@selbtn_s_2,
	"要求暂停", //ストップをかける,
	"由他选择" //そのまま選んでもらう
)@selbtn_log
IF(@選択==0){		// (ストップをかける/そのまま選んでもらう) ストップをかける

	@bgm_stop(500)
	【@音無】"「暂停」"R //「ストップ」R
	
	@bs(hn0406)
	KOE(001100077,010)【@日向】"「嗯？」"R //「ん？」R
	【@音無】"「可以不要从右边的口袋里选，改成从左边的口袋里选择吗？」"R //「右ポケットじゃなく、左ポケットから選んでみてくれないか？」R
	
	@bgm_play(m212)
	@bs(hn0209_07)
	KOE(001100079,010)【@日向】"「诶？为什么？」"R //「え？　どーして？」R
	"我已经知道他口袋里藏着的玄机了。"R //すでに俺はポケットのからくりを知っている。R
	【@音無】"（那么…日向你又如何应对！？）"R //（さて…日向は、どう出る！？）R
	
	@bs(hn0109)
	KOE(001100082,010)【@日向】"「我的左口袋里一张饭票都没有哦？」"R //「左ポケットには食券は入ってないんだが？」R

	@@選択=SELBTN(@selbtn_s_2,
		"提出质疑", //ダウトを告げる,
		"接受从右口袋里选择饭票" //右ポケットで納得しておく
	)@selbtn_log
	IF(@選択==0){		// (ダウトを告げる/右ポケットで納得しておく) 

		【@音無】"「我质疑！」"R //「ダウト！」R
		
		@bs(hn0108)
		KOE(001100091,010)【@日向】"「诶，质疑什么啊…！？」"R //「え、なにが…！？」R

		;－－－●イケチンと言った時に殴る約束のフラグは立ってる？　■■＠■■殴る宣言を回避できてしまうので分岐条件を変更しました。（角）　ＯＫ（前田）R
		;IF(@日向をイケチンと言い間違えた回数>=2)
		IF(@イケチン次は殴る==1||@イケチン叱って次は殴る==1){
			//TODO：岩泽线结束后翻译

			@bgm_stack
			@bgm_stop(2000)
			@イケチンon

			;;【@音無】「すまない、イケチン…俺はお前の上着を確認してしまったんだ」R
			【@音無】"「すまない、イケチン…俺はお前の上着を…」"R //「すまない、イケチン…俺はお前の上着を…」R

			@bgm_play(m118)
			@bf(bs3_hn0105_09)
			@pcmch_play(0, @殴る)// 効果音(日向が音無を殴る)
			@横揺れ_強(1)

			"そう告げるとなぜか、ばきぃ！と殴られ、歯が飛ぶ…。"R //そう告げるとなぜか、ばきぃ！と殴られ、歯が飛ぶ…。R
			
			【@音無】"「イテェ…暴力に訴えるなんて、最低だぜ…」"R //「イテェ…暴力に訴えるなんて、最低だぜ…」R
			
			@bs(hn0105)
			KOE(001100100,010)【@日向】"「いや、お前がイケチンと言ったからだが？」"R //「いや、お前がイケチンと言ったからだが？」R
			【@音無】"「え！？　まさか…またも！？」"R //「え！？　まさか…またも！？」R

			@日向on

			@bs(bs2_hn0208@00a)
			KOE(001100102,010)【@日向】"「だから、その演技要らないから」"R //「だから、その演技要らないから」R
			【@音無】"「くっそ…」"R //「くっそ…」R
			
			@縦揺れ_弱
			
			【@音無】"「って、今は俺が問い詰めてるシーンなのに、なぜ立場が逆転してる！？」"R //「って、今は俺が問い詰めてるシーンなのに、なぜ立場が逆転してる！？」R
			
			@bs(hn0105_09)
			KOE(001100105,010)【@日向】"「お前がイケチンって言うからだろ」"R //「お前がイケチンって言うからだろ」R
			【@音無】"「じゃあ、言い直す」"R //「じゃあ、言い直す」R
			
			@bs(hn0101)
			KOE(001100107,010)【@日向】"「ああ」"R //「ああ」R
			@bgm_stop(3000)
			【@音無】"「イケ…" @timewaitkey(500) "いや、日向…俺はお前の上着を確認してしまったんだ」"R //「イケ… @timewaitkey(500) いや、日向…俺はお前の上着を確認してしまったんだ」R

			"あまり説得力のない言い方になってしまった。"R //あまり説得力のない言い方になってしまった。R
			@bgm_pop_play

			@AB08で日向に殴られた１=1
			@日向をイケチンと言い間違えた回数+=1

		;;■■コメントアウト待避133■■

		}else{		;－－－■■＠■■何も無い場合が無かったので追加しました。（角）　ＯＫ（前田）R

			【@音無】"「抱歉…我确认了一下你的上衣口袋」"R //「すまない…俺はお前の上着を確認してしまったんだ」R

		}

		@bs(hn0106)
		KOE(001100185,010)【@日向】"「什…」"R //「な…」R
		【@音無】"「你左口袋里的饭票，都是适合早餐的清淡食物，而右口袋里则是不适合早餐的油腻食物…」"R //「左ポケットには、朝食に相応しい軽めの食券、右ポケットには朝食には相応しくない重い食券が入ってることを…」R
		
		@bs(hn0407)
