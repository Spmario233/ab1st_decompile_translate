		KOE(000500334,010)【@日向】"「喂喂，快把头抬起来吧！我只是要陪着你而已吧」"R //「おいおい、顔を上げろよ！　ただ傍に居るだけだからさっ」R
		"这就是我所要感谢的啊…。"R //それがありがたい…。R

		@その気さらにあり=1

	}ELSE{

		【@音無】"「谢谢…」"R //「ありがたい…」R
		
		@bs(hn0402)
		KOE(000500342,010)【@日向】"「我的职责就是照顾新人。不用客气！」"R //「新米の世話をするのは、俺の任務。気にすんな！」R
		【@音無】"「嗯…」"R //「ああ…」R

		IF(@０１日ホモ疑惑||@さらにホモ疑惑){

			"有点恐怖的感觉…。"R //若干の怖さを覚えるが…。R

		}

	@bs
	goto #hinata_sentaku	;日向と一緒に行動するかの直前へ（魁

	}

}

