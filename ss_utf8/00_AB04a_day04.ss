;－－－□寮　水曜日
//@DAYS=04
@DAYS += 1	@day_change		// 04日目
$bs_dress_init

;;@音無をただのエロ少年と呼ぶ=1
;;@ゆりへの思い日向がなんとかしてくれる=1

//@岩沢消えなかった = 1 // 消えたときに 0 に倒すよう仕様変更します。ややこいけどこうしないと岩沢(いる/いない)の判定に使えない（西
;－－－朝 金曜
@bg(ep99_bg001, 143)

@pcmch_play(1, @小鳥のさえずり, 500)//効果音(小鳥のさえずり)

"我在和往常一样的时间醒来了。"R //いつも通りの時間に目が覚める。R

//@pcmch_play(0, @着替え)		// 効果的と思えないのでコメントアウト（西

"虽然躺着看不到日向的身影，但是能听到他正在打理自己的声音。"R //ここから日向の姿は見えないが、ごそごそと用意をしている音が聞こえる。R
"差不多该起床了吧…。"R //そろそろ起きるか…。R

@bgm_play(m301)		;;♪日常曲（朝の寮の部屋など）

IF(@音無をただのエロ少年と呼ぶ==0){

	@bs(hn0104)
	KOE(000500013,010)【@日向】"「音・无～…哟，已经起床了吗」"R //「お・と・な・し…っと、もう起きてたか」R
	【@音無】"「嗯…」"R //「ああ…」R

}else{
//IF(@音無をただのエロ少年と呼ぶ==1){

	@bs(hn0204)
	KOE(000500019,010)【@日向】"「音…不对，只是个色批少年，已经起床了吗」"R //「おと…じゃなく、ただのエロ少年、もう起きてたか」R
	【@音無】"「嗯…」"R //「ああ…」R
	"そ每当他这么称呼我的时候，我都会反省那天的过错。"R //そう呼ばれる度、あの日の過ちを反省できる。R

}


// k-takahashi ↓条件修正しました
//IF(@松下関係で怪我==1||@野田との訓練全身刻まれた==1){
if( @昨日怪我した ) {
	@bs(hn0102)
	KOE(000500028,010)【@日向】"「身上的伤都愈合了吗？」"R //「怪我の具合はどうだ？」R

	@bs
	
	IF(@受け身の練習でむちうちに){

		"我左右晃了晃头，完全感觉不到疼痛。"R //首を左右に振ってみる。まったく痛みはない。R

	}ELSE{
		
		"我爬了起来，活动了活动，试着做起了轻度伸展运动。"R //立ち上がり、体を起こして、軽くストレッチしてみる。R
		"完全感觉不到疼痛。"R //まったく痛みはない。R

	}

	@野田との訓練全身刻まれた=0
	//@松下関係で怪我=0

}


@bs(hn0404)
KOE(000500047,010)【@日向】"「好嘞，去洗洗脸换换衣服，然后吃早饭吧」"R //「よっし、顔洗って着替えて、朝飯食いにいこうぜ」R

IF(@ガルデモメンバーは駄目だった==0){

	【@音無】"「好」"R //「おう」R

}ELSE{

	【@音無】"「好…」"R //「おう…」R

}

@pcmch_stop(1, 1000)
@bgm_stop(2000)
@fade(bg_kuro, 25)

@bg(ep05_bg047, 25)

@bgm_play(M119)		;;♪日向のロシアン食券時

@bs(hn0402)
KOE(000500059,010)【@日向】"「那么，你的早饭是～？」"R //「さって、お前の朝食はー？」R
"他这次也将手伸进了口袋。"R //またポケットをまさぐる。R

@bs(hn0104)
KOE(000500061,010)【@日向】"「是这个！" @ruby餐品11_玛格丽特披萨 "！」"R //「これだ！　マルゲリータピザ！」R
【@音無】"「一个学校食堂里，竟然还有这种东西！」"R //「学食で、そんなメニューあるのかよっ！」R

@bs(hn0102)
KOE(000500063,010)【@日向】"「对，很厉害吧。确实真的有」"R //「ああ、すげーだろ。あるんだよ」R
"他把饭票递给了我。"R //その食券を渡される。R

@bs(hn0403)
KOE(000500065,010)【@日向】"「我的是…" @ruby餐品12_火腿热狗 "！！」"R //「俺はーと…ハムドッグー！！」R
【@音無】"（明明同样是西餐，但显然他的那份对刚起床的身体更适合吧…！！）"R //（同じ洋食だが、そっちのほうが遙かに寝起きに優しい気がする…！！）R

@bs

;－－－朝食
KOE(000500070,051)【食堂のおばさん】"「给，玛格丽特披萨」"R //「ほい、マルゲリータピザ」R
"…好大。"R //…でかい。R
"这个量显然是给几个人一起分着吃的吧…。"R //これは数人でシェアするサイズのメニューだ…。R
"我一个人真的能吃完吗…。"R //ひとりで食い切れということなのか…。R

@bgm_stop(2000)

@bg(ep06_bg015, 25)

@bgm_play(m106)		;;♪日常（ＳＳＳメンバーが一緒に居るときなど）

"我坐到了餐桌前，日向几分钟之内就吃完了他那份易于消化的火腿热狗。"R //テーブルにつくと、日向は胃に優しそうなハムドッグを数分で食べきる。R
"但是，我的披萨还剩下整整三分之二…。"R //しかしまだ俺のピザは２／３残っている…。R
"第一块披萨吃起来相当美味。"R //最初の一切れは美味しかった。R
"但一想到剩下的七块披萨都是这个味道，不由得就郁闷了起来…。"R //それ以降、ずっとこの味を７カット食べると思うと、気分は沈む…。R
"而且很快就凉了下来，味道也变差了…。"R //しかもどんどんと冷めていき、味も落ちていく…。R

@@選択=SELBTN(@selbtn_s_2,
	"请求日向帮忙", //日向に手伝ってもらう,
	"把剩下七块全吃了" //７枚重ねて一気に食べる
)@selbtn_log
IF(@選択==0){		// (请求日向帮忙/把剩下七块全吃了) 请求日向帮忙

	【@音無】"「喂，日向，能帮我一下吗…」"R //「なあ、日向、手伝ってくれないか…」R
	
	@bs(hn0109_07)
	KOE(000500087,010)【@日向】"「诶诶—…那么，只吃一块哦？」"R //「ええー…じゃ、一枚だけだぞ？」R
	"仅仅如此就已经帮大忙了。"R //それだけでもありがたい。R
	
	@bs
	
	"他一下子就吃掉了其中一块。"R //ぺろんと食べてくれる。R
	【@音無】"「看你吃的这么轻松，再吃一块也没问题吧？」"R //「お前の調子なら、もう一切れ、いけないか？」R
	
	@bs(hn0109_07)
	KOE(000500091,010)【@日向】"「大早上的，已经吃不下了」"R //「朝だし、もう無理だよ」R

	IF(@さらにホモ疑惑==1){

		【@音無】"「求求你了…」"R //「そこを頼むよ…」R
		
		@bs(hn0407)
		KOE(000500096,010)【@日向】"「那行吧，只有今天这一次哦—」"R //「じゃあ、今日だけだぞー」R
		
		@bs
		
		"他又帮我吃掉了一块。"R //もう一枚食べてもらえた。R
		
		@bs(hn0102)
		KOE(000500098,010)【@日向】"「总有一天要让你报恩的哦—」"R //「この貸しはいつか返してもらわないとなー」R
		【@音無】"（可恶！！忘了日向是个同性恋啊！！）"R //（まずい！！　日向がホモだったことを忘れていた！！）R
		
		@bs(hn0207)
		KOE(000500100,010)【@日向】"「怎么了？你好像有点颤抖啊？」"R //「どうした？　震えてねーか？」R
		【@音無】"「才没有那种事情…」"R //「そんなことはない…」R
		//		残り五枚をなんとか食べきった。R

		@bs
		
		@ホモに貸しを作ってしまう=1

		"………。"R //………。R
		"……。"R //……。R
		"…。"R //…。R
		【@音無】"（…好！）"R //（…よっし！）R
		"终于，吃完了！"R //どうにか、食べきった！R

	}ELSE{		// not (@さらにホモ疑惑==1)

		【@音無】"「是吗…那看来只能我自己把它吃完了…」"R //「そっか…自分で食い切るしかないか…」R
		
		@bs(hn0107)
		KOE(000500115,010)【@日向】"「欸？要是吃不完的话，剩着不就行了」"R //「え？　食い切れねーなら、残したらいいじゃん」R

		IF(@その気さらにあり){

			【@音無】"「不行，我可不能那么娘们唧唧的！是男人就要把它吃完！」"R //「いや、そんな女子的な思考は俺にはないっ！　男なら完食すべきだ！」R
			
			@bs(hn0209)
			KOE(000500120,010)【@日向】"「虽然不太明白，但要这样的话，嘛，加油吧…」"R //「よくわからないけど、それなら、まあ、頑張れよ…」R
			【@音無】"「嗯」"R //「ああっ」R
			
			@bs
			
			"花了很长时间，总算是吃完了。"R //時間をかけなんとか完食した。R
			【@音無】"「呼—，你看…我吃完了…感觉如何？」"R //「ふぅー…食い切ったぜ…どうだ？」R
			
			@bs(hn0109_07)
			KOE(000500124,010)【@日向】"「就算你这么一脸得意，我也没什么好回应的啊…」"R //「そんなどや顔されても、何も言い返せないんだが…」R
			【@音無】"「好吧…」"R //「そうか…」R
			
			@bs(hn0306)
			KOE(000500126,010)【@日向】"「为什么沮丧起来了啊！」"R //「なんで気落ちしてんだよっ！」R
			【@音無】"「不，没什么…」"R //「いや、別に…」R
			
			@bs(hn0109)
			KOE(000500128,010)【@日向】"「明显已经黑化了好吧！别把自己这么逼到极限啊…」"R //「明らかに暗いぜ！　それだけ限界だったってことか…」R
			【@音無】"「嗯…」"R //「ああ…」R
			
			@bs

		}ELSE{
			
			@bs
			
			【@音無】"（是吗…竟然还可以这样！）"R //（そうか…その手があったか！）R
			"不过，虽然没有记忆，但我还记得应该要“谁知盘中餐，粒粒皆辛苦”。"R //でも、記憶にはないが、せっかく調理してくれた料理を食べ残すことに抵抗を覚える。R
			"还是以尽量不剩饭为目标，继续吃吧…。"R //出来るだけ残さないよう、食べ進める…。R
			【@音無】"「咕…好撑啊…」"R //「く…重い…」R
			"日向则一直在旁边等待着我。"R //日向はどれだけでも待ってくれている。R
			"终于咽下了最后一块，结束了这顿饭。"R //ようやく最後のピースを飲み込み、食べ終わる。R

		}

		【@音無】"「我吃饱了…」"R //「ごちそうさまでした…」R

		@ピザで満腹状態=1

		//	GOTO #SHOKUGONOOCHA

	}		// IF(@さらにホモ疑惑==1) 判定処理のケツ

}ELSEIF(@選択==1){		// (请求日向帮忙/把剩下七块全吃了) 把剩下七块全吃了

	"已经没有退路了…。"R //やるしかない…。R
	"我把剩下七块披萨叠了起来，压扁成了一整块。"R //残り７枚を重ねて、押しつぶす。R
	
	@bs(hn0406)
	KOE(000500154,010)【@日向】"「…诶？」"R //「…え？」R
	
	@bs
	
	"我在已经呆住了的日向面前，把披萨块塞进了嘴里。"R //日向がぽかんと見ている前で、それを口に突っ込んだ。R
	"用手掌强行压住了披萨。"R //強引に手のひらで押し込む。R
	【@音無】"「呜…！！」"R //「うっ…！！」R
	"已经无法呼吸了。"R //呼吸が出来なくなった。R
	
	@縦揺れ_弱
	
	【@音無】"「嗯嗯嗯嗯————！！」"R //「んんんんーーーー！！」R
	
	@bs(hn0105)
	KOE(000500160,010)【@日向】"「喂，音无！」"R //「おい、音無っ！」R
	
	@fade(bg_kuro,4,0)	//文章と同期
	
	//	チェックシート修正。ただのエロ少年抜けのため、テキスト追記		西村
	//呼びかけられるが、俺はそこで気を失ってしまう…。R
	"随着日向焦急的呼喊声，我失去了意识…。"R //焦った日向に呼びかけられるが、俺はそこで気を失ってしまう…。R

	close
	@timewaitkey(3000)
	
	@bg(ep06_bg015)
	
	"恢复意识的时候，映入眼帘的是食堂的天花板。"R //次気づくと、食堂の天井が見えた。R
	
	@bs(bs3_hn0103)
	KOE(000500164,010)【@日向】"「呦，醒了吗」"R //「よう、目覚めたか」R
	"眼前突然出现了日向的脸。"R //突然、日向の顔が目の前に現れる。R

	IF(@さらにホモ疑惑){

		"我正被他膝枕着。"R //膝枕をされていた。R
		
		@bs
		@横揺れ_弱
		
		"我拼尽全力地翻滚着，想要逃离他。"R //俺は逃れようと全力で転がった。R

		@pcmch_play(0, @テーブル破壊)//効果音(机や食器が音を立てる/アニメには描写無し)
		@縦揺れ_強
		
		"咣——！"R //ガシャーーン！R
		"桌子被撞飞了，连带着上面放着的水一起被华丽地洒出来了。"R //机が飛んでいき、載っていた水だろうか、それを派手にまき散らしてしまう。R
		
		@pcmch_stop(0, 500)

		@bs(hn0209_07)
		KOE(000500173,010)【@日向】"「喂喂，是我啊？」"R //「おいおい、俺だぜ？」R
		【@音無】"「我知道是你才…」"R //「お前だからだ…」R
		
		@bs(hn0207)
		KOE(000500175,010)【@日向】"「哈？」"R //「は？」R
		
		@bs(hn0101)
		KOE(000500176,010)【@日向】"「嘛，算了。你现在能呼吸了吗？」"R //「まあ、いい。もう、呼吸も出来るだろ？」R
		【@音無】"（啊，对了…。我刚才窒息而死了…）"R //（そうだ、そうだった…。俺は窒息死していたんだ…）R
		
		@bs
		
		//		@ピザで窒息死した=1

		//		GOTO #SHOKUGONOOCHA

	}elseif(@その気さらにあり){

		"我正被他膝枕着。日向的膝盖好暖和好舒服，真想这样一直枕下去…。"R //膝枕をされていた。日向の膝が温かく気持ちいい。いつまでもこうして居たい…。R
		
		@bs(hn0104)
		KOE(000500186,010)【@日向】"「怎么样了？你现在能呼吸了吗？」"R //「どうだ？　もう、呼吸も出来るだろ？」R
		【@音無】"（啊，对了…。我刚才窒息而死了…）"R //（そうだ、そうだった…。俺は窒息死していたんだ…）R
		【@音無】"「嗯…已经能正常呼吸了…」"R //「ああ…普通にできる…」R
		
		@bs(hn0209)
		KOE(000500189,010)【@日向】"「不过你到底为什么要那么猛塞啊…真吓死我了…」"R //「しかしどうして、あんな食い方をしたんだよ…びっくりしたぜ…」R
		
		@bs(hn0201)
		KOE(000500190,010)【@日向】"「要是吃不完的话，剩在那里就行了」"R //「食えないんだったら残せばよかったのに」R
		【@音無】"「不行，感觉这么做像女孩子似的，不太好…」"R //「いや、それは女子のようで格好悪いと思って…」R
		
		@bs(hn0104)
		KOE(000500192,010)【@日向】"「在我面前还顾虑这个干嘛啊…」"R //「んなことねーよ。俺相手に何考えてんだよ…」R
		"绝对不能说出来…。"R //それは言えない…。R
		
		@bs(hn0101)
		KOE(000500194,010)【@日向】"「………」"R //「………」R
		【@音無】"「………」"R //「………」R
		
		@bs(hn0209)
		KOE(000500196,010)【@日向】"「…呃，你差不多可以起来了吧…？」"R //「…ええと、そろそろ、起きてくれないか…？」R
		【@音無】"「啊，嗯，确实…」"R //「あ、ああ、だな…」R
		
		@bs
		
		"我恋恋不舍地站了起来。"R //名残惜しいが、起き上がる。R

		//		@ピザで窒息死した=1

		//		GOTO #SHOKUGONOOCHA

	}else{

		"我正被他膝枕着。"R //膝枕をされていた。R
		
		@bs(hn0104)
		KOE(000500186,010)【@日向】"「怎么样了？你现在能呼吸了吗？」"R //「どうだ？　もう、呼吸も出来るだろ？」R
		
		【@音無】"（啊，对了…。我刚才窒息而死了…）"R //（そうだ、そうだった…。俺は窒息死していたんだ…）R
		【@音無】"「嗯…已经能正常呼吸了…」"R //「ああ…普通にできる…」R
		
		@bs(hn0209_07)
		KOE(000500189,010)【@日向】"「不过你到底为什么要那么猛塞啊…真吓死我了…」"R //「しかしどうして、あんな食い方をしたんだよ…びっくりしたぜ…」R
		
		@bs(hn0209)
		KOE(000500190,010)【@日向】"「要是吃不完的话，剩在那里就行了」"R //「食えないんだったら残せばよかったのに」R
		【@音無】"「感觉这么做对不起那些做饭的人…」"R //「いや、やっぱり作ってくれた人のことを考えると…」R
		
		@bs
		
		"我一边说着，一边站了起来。"R //言いながら、起き上がる。R
		
		@bs(hn0101)
		KOE(000500214,010)【@日向】"「食堂阿姨们也都是NPC哦？完全不用有罪恶感的」"R //「学食のおばさんもＮＰＣなんだぜ？　罪悪感も何も考えなくていいだろ」R
		【@音無】"「嘛，话是这么说没错…但从外表上看完全是人类啊…」"R //「まあ、そうなんだけどさ…見た目は完全に人間だしな…」R
		
		@bs(hn0102)
		KOE(000500216,010)【@日向】"「哈啊…游离子之前没和你说过，要多适应适应吗？」"R //「はぁ…ゆりっぺから順応していくことが大事だって言われなかったか？」R
		【@音無】"「感觉好像说过…」"R //「言われた気がする…」R
		
		@bs
		
		//		@ピザで窒息死した=1

		//		GOTO #SHOKUGONOOCHA

	}

	@ピザで窒息死した=1

}		// (请求日向帮忙/把剩下七块全吃了) 選択肢処理のケツ

