	}ELSE{

		KOE(000502455,010)【@日向】"「おい、音無、聞こえてねーのか？」"R //「おい、音無、聞こえてねーのか？」R

	}

	【@音無】"「え？　あ、すまんっ、なんだ？」"R //「え？　あ、すまんっ、なんだ？」R
	"慌てて本を閉じる。"R //慌てて本を閉じる。R
	
	@bs(hn0104)
	KOE(000502461,010)【@日向】"「消灯の時間だよ」"R //「消灯の時間だよ」R
	【@音無】"「もうそんな時間か…」"R //「もうそんな時間か…」R
	
