	@bgm_play(m090)		// キャッキャウフフテーゼ(ループ)
	@キャッキャウフフ開始(hn0204, 3)
	KOE(000502223,010)【@日向】"「でも、俺の図書カードを使ったんだから、俺が借りてることになっちゃってるからなー。俺は確認する権利があると思うんだけどなー」"R;>>キャッキャウフフ風に //「でも、俺の図書カードを使ったんだから、俺が借りてることになっちゃってるからなー。俺は確認する権利があると思うんだけどなー」R
	【@音無】"「それは卑怯すぎるぜぇーー！！」"R //「それは卑怯すぎるぜぇーー！！」R
	
	@bs_w(2, hn0202)
	KOE(000502225,010)【@日向】"「俺が借りたも同然だぁー！　ほら、どけよぉー！　確認させてもらうぜぇーー！？」"R //「俺が借りたも同然だぁー！　ほら、どけよぉー！　確認させてもらうぜぇーー！？」R
	【@音無】"「だからやめろってぇー、反則だぜぇーー！！」"R //「だからやめろってぇー、反則だぜぇーー！！」R
	
	@キャッキャウフフ終了フェード
	
	"ふたり肩をぶつけ合い、キャッキャウフフした。"R //ふたり肩をぶつけ合い、キャッキャウフフした。R

	@肩をぶつけ合ってキャッキャウフフした=1
	@実績チェック

	@キャッキャウフフ終了
	@bgm_pop_play
	
	【@音無】"「そうだ、日向っ！　図書カードありがとう！！」"R //「そうだ、日向っ！　図書カードありがとう！！」R
	
	"俺は日向に図書カードを返す。"R	;;採用！	 //俺は日向に図書カードを返す。R	
	
	@日向とキャッキャウフフした+=1	;;MAX3	or	MAX1(ここで初取得可能)

	GOTO #IYAORENOWA

}


