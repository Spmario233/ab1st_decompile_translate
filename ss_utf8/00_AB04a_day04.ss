#JAFOROIKU

@bgm_stop(2000)
@fade(bg_kuro, 25)
;－－－□寮
@bg(ep99_bg003, 25)

@bgm_play(m303)		;;♪日常曲（夜の寮の部屋など）

;－－－■■＠■■何もない場合はJAAHUROIKUKAへ飛ばないとまずそうなので↓のほうに追加します（角）　ＯＫ（前田）R
// 外科手術（if文とelseのみで対処）したので、↑は無くなりました。当然元のフローと同じ動作のまんま（西

"我们结束了今天的战线活动之后，回到了宿舍。"R	;;寮に帰ってきたというワンクッションをここに。（魁0329 //今日の戦線での活動も終わり、寮に戻ってきた。R	

IF(@ゆりへの思い日向がなんとかしてくれる){

	;－－－■■＠■■テキスト修正　夕飯は会議前に食べている形です。（角）　ＯＫ（前田）R
	;夕飯を食べ終え、寮に戻る。R

	;;今日の戦線での活動も終わり、寮に戻ってきた。R

	IF(@AB03日向と風呂に入ることがなくなった){

		//	少しだけ文章修正		西村
		//すぐさま風呂に行くと思っていた、日向は無言のままベッドで横になる。R
		"本以为他马上就去洗澡的，但是日向却一言不发地倒在了床上。"R //すぐさま風呂に行くと思っていたが、日向は無言のままベッドで横になる。R

	}ELSE{

		"本以为他马上就会说“去洗澡吧”，没想到日向却一言不发地倒在了床上。"R //すぐさま風呂に入ろうと言い出すかと思いきや、日向は無言のままベッドで横になる。R

	}

	@pcmch_play(0, @鉄製ノック)
	"我正想问问他的状况，但是却响起了敲门声。"R //どうした、と声をかけようとした時、ノックの音がした。R
	@pcmch_play(0, @寮扉開ける)
	"日向站了起来，打开了门，但是只露出了一条缝。看不到对方的身影，究竟会是谁呢？"R //日向が起き上がり、ドアを開く。だがほんのちょっとだ。相手の姿は見えない。誰だろう？R

	;;▼▼あとで【声】に修正 //译注：050的语音编号，不是登记在册的角色，疑似是Guild的野人
	KOE(000501759,050)【声】"「东西弄到了」"R //「例のものです」R
	
	@face(hn0103)
	KOE(000501760,010)【@日向】"「谢了啊。给，稀有饭票」"R //「すまねーな。ほら、レア食券だ」R
	KOE(000501761,050)【声】"「交易愉快」"R //「ありがたいっす」R
	"就好像是在目击毒品交易现场一样。"R //まるでヤクの取引のようだった。R
	KOE(000501763,050)【声】"「再见」"R //「では」R
	;;▲▲あとで【声】に修正ここまで

	@face(hn0103)
	KOE(000501766,010)【@日向】"「嗯」"R //「ああ」R
	
	@bs(hn0101)
	"看来对话结束了，神秘人士也离开了。日向转过来面对了我。"R //話し終えたようで、何者かは去り、日向が俺のほうを向く。R
	【@音無】"「那是什么？」"R //「なんだったんだ？」R

	@bs(hn0105_09)
	IF(@AB03日向と風呂に入ることがなくなった){

		KOE(000501772,010)【@日向】"「新鲜才是最重要的。我马上要去洗澡了，在那之前先把这个交给你。把手伸出来」"R //「鮮度が命だ。俺はすぐさま風呂に行く。その前にこれをお前に託す。手を出せ」R

	}ELSE{

		KOE(000501776,010)【@日向】"「新鲜才是最重要的。我先一个人去洗澡了，在那之前先把这个交给你。把手伸出来」"R //「鮮度が命だ。俺はひとりですぐさま風呂に行く。その前にこれをお前に託す。手を出せ」R

	}
	
	@bs
	
	"我照他说的伸出了手。他把像是布一样的东西放到了我的手里，仍然带着微微的温度。"R //言われたように手を差し出すと、布が置かれる。わずかに温かい。R
	【@音無】"「这…这是…？」"R //「こ…これは…？」R
	
	@bs(bs3_hn0108)
	
	//KOE(000501782,010)【@日向】「…ゆりっぺの脱ぎ立てパンティーだ」R
	KOE(000501782,010)【@日向】"「…游离子刚脱下来的内裤」"R //「…ゆりっぺの脱ぎたてパンティーだ」R

	IF(@AB04エロ本をどもった){
		
		@横揺れ_弱
		
		【@音無】"「诶…诶诶诶…诶诶？诶诶诶诶诶————————！？」"R //「え…えええ…ええ？　えええええーーーーーーーー！？」R
		"整个人都颤抖了起来。"R //すごく動揺してしまう。R

	}ELSE{

		【@音無】"「真…真…真的假的…」"R //「ま…ま…マジかよ…」R
		"声音和手一起颤抖着…。"R //手と声が同時に震える…。R

	}

	@bs(bs2_hn0103@00a)
	KOE(000501796,010)【@日向】"「嗯。这种程度的事情还是能帮你做到的。用别的内裤调包了，应该不会被她发现」"R //「ああ。これぐらいのことなら出来る。別のパンツと差し替えさせたから、バレることもない」R

	@bs(hn0104)
	KOE(000501797,010)【@日向】"「但是，这既是第一次也是最后一次…」"R //「でも、今回が最初で最後だからな…」R

	;－－－■■＠■■こっから大幅に変更　ＯＫ（前田）R
	@bs(hn0403)
	KOE(000501800,010)【@日向】"「那么，我去洗澡了。差不多二十分钟左右之后回来。这期间随你怎么做都可以。应该足够让你对游离子干到腻了吧」"R //「じゃあ、俺は風呂に行く。２０分ぐらいで戻ってくるだろう。その間、好きにしな。ゆりっぺを飽きるぐらいにな」R

	@@選択=SELBTN(@selbtn_s_2,
		"嗯，谢谢了", //ああ、ありがとう,
		"不，我可不能收下" //いや、受け取れない
	)@selbtn_log
	IF(@選択==0){		// (ああ/いや) ああ

		IF(@AB04エロ本をどもった){

			@横揺れ_弱
			
			【@音無】"「谢，谢，谢谢…谢谢谢谢，谢谢谢谢了…！」"R //「あ、あ、ああ…ああああ、あああありがとう…！」R
