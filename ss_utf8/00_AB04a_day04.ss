	"在日向的催促下，我们离开了作战总部。"R //日向に促され、本部を後にする。R
	
	GOTO #JAFOROIKU

}

IF(@岩沢に興味が湧いた){

	;－－－□本部　暗い？
	@@選択=SELBTN(@selbtn_s_2,
		"就这样目送她离开", //そのまま見送る,
		"追上去并叫住她" //追って呼び止める
	)@selbtn_log
	IF(@選択==0){		// (就这样目送她离开/追上去并叫住她) 就这样目送她离开
		
		//	ちょっと文章足してみました		西村
		//そのまま見送った。R
		"不管是作战内容的方面，还是音乐的方面，我这个新来的都没有说三道四的权力。"R //作戦内容のことにしても、音楽のことにしても、新入りの俺がとやかく言える内容じゃない。R
		"没办法，只能就这样目送她离开了。"R //仕方なく、そのまま見送った。R

	}ELSE{	// IF(@選択==1){{		// (就这样目送她离开/追上去并叫住她) 追上去并叫住她

		IF(@岩沢と話して間接キスした){

			【@音無】"（我可是和岩泽间接接吻过的关系啊！）"R //（岩沢とは間接キスした仲だ！）R

		}
		
		@bgm_stop(2000)
		@fade(bg_kuro, 24)
		
		"我也从作战总部冲了出去。"R //俺も本部を飛び出した。R
		
		
		;－－－□本部前
		@bg(ep05_bg026, 25)
		@bgm_play(m127)

		;－－－●他の怪我をしていても　■■＠■■松下にも汎用怪我フラグあった方が楽かもです（角）　設定してみて（前田）
		;松下のテキストにフラグを追加しておきました。ただ痛む系のテキストはすべてそれでいけるはずです。（角）　ＯＫ（前田）R

		IF(@怪我してる){

			【@音無】"「好疼疼疼…」"R //「イテテテ…」R
			"一追起来就浑身疼痛。"R //追うと全身が痛む。R
			【@音無】"「等一下，岩泽！」"R //「待てよ、岩沢！」R

		}else{

			【@音無】"「等一下，岩泽！」"R //「待てよ、岩沢！」R

		}

		"我叫住了岩泽。"R //岩沢を呼び止めた。R
		
		@bs(iw0301_10)
		KOE(000501662,004)【岩沢】"「…嗯？怎么了」"R //「…ん？　なに」R
		"她慵懒地回头看着我。"R //気だるそうに振り返る。R

		IF(@岩沢と話して間接キスした==0){

			GOTO #OREWASUGEE

		}

		@@選択=SELBTN(@selbtn_s_2,
			"称赞她的歌", //曲を褒める,
			"对岩泽动心了" //岩沢に惚れる
		)@selbtn_log
		IF(@選択==0){		// (称赞她的歌/对岩泽动心了) 称赞她的歌

			#OREWASUGEE
			
			【@音無】"「我觉得这首歌非常棒」"R //「俺は、すげーいい曲だと思った」R
			
			@bs(iw0108)
			KOE(000501679,004)【岩沢】"「就算非常棒，如果不能用在佯攻的话，也没有意义了」"R //「すげーいい曲でも、陽動に使えないんじゃ意味がない」R
			
			@bs(iw0110)
			KOE(000501680,004)【岩沢】"「如今的GDM，没有战线的支持，是无法展开活动的」"R //「今やガルデモは戦線のバックアップなしには活動できない」R
			
			@bs(iw0109)
			KOE(000501681,004)【岩沢】"「既然由理这么判断，那就只能雪藏了」"R //「ゆりがそう判断したなら、お蔵入りなんだよ」R
			【@音無】"「我要直接上表由理！绝对能吸引注意力的！就是这么优秀的曲子啊！」"R //「俺が直訴してきてやるよ！　ぜってー、足止めになる！　それぐらいいい曲だ！」R
			
			@bs(iw0101)
			KOE(000501683,004)【岩沢】"「如果你真这么喜欢的话，那我下次会单独为了你唱的」"R //「そんなに気に入ったのなら、今度あんたのためだけに歌ってやるよ」R
			
			@bs(iw0110)
			KOE(000501684,004)【岩沢】"「所以，不要太妨碍由理哦」"R //「だから、あんまり、ゆりの邪魔をするな」R
			
			@bs(iw0301)
			KOE(000501685,004)【岩沢】"「不管什么时候，她所作的判断都是正确的。明白了吗？」"R //「いつだって、あいつの判断は正しかったんだ。いいな？」R

			IF(@野田との訓練全身刻まれた０３){

				"我吐出了一口血，代替了回答。"R //返事の代わりに、ごふっと吐血してしまう。R
				
				@bs(iw0307)
				KOE(000501690,004)【岩沢】"「赶紧好好休息一下吧」"R //「とっとと休むこったな」R

			}else{
				
				"我急得无可奈何。"R //歯がゆくて仕方がない。R
				"但是，这不是像我这样的新人该插手的事情…。"R //でも、俺のような新参が口出すところではなかったんだ…。R
				"…我还真是无能为力啊。"R //…無力だな、俺。R
				【@音無】"「知道了…」"R //「わかったよ…」R

			}

			@bs(iw0302)
			KOE(000501701,004)【岩沢】"「那拜拜」"R //「じゃあな」R
			
			@bs
			
			"说完之后，岩泽便转身离开了，而我只能这么默默地目送她离开。"R //そう言って背中を向ける、岩沢を無言で見送るしかなかった。R

			@岩沢の新曲を褒めた=1

		}ELSEIF(@選択==1){		// (称赞她的歌/对岩泽动心了) 对岩泽动心了

			【@音無】"「我对你心动了」"R //「俺は、お前に惚れた」R
			
			@bs(iw0106)
			KOE(000501709,004)【岩沢】@bc"「哈？什么意思」"@bs_c(1000, iw0107)R //「は？　なんだよ、それ」@bs_c(1000, iw0107)R
			【@音無】"「因为，你总是一幅冰山美人的样子，而且唱歌也很棒…」"R //「いや、お前はいつもクールビューティーで、歌も上手くてさ…」R
			
			@bs(iw0108)
			KOE(000501711,004)【岩沢】"「这种恶趣味的玩笑就算了」"R //「やめてくれ、そんな悪いジョーク」R
			【@音無】"「我可是认真的…」"R //「結構、本気なんだが…」R
			
			@bs(iw0309)
			//	チェックシート修正。「惚れらても」→「惚れられても」＆ニュアンス調整		西村
			//KOE(000501713,004)【岩沢】「見た目や歌の上手さだけで、惚れらてもこっちは困るんだよ」R
			KOE(000501713,004)【岩沢】"「不管你是喜欢上了我的外表还是歌声，我都会很困扰的」"R //「見た目や、歌の上手さだけで惚れられても、こっちは困るんだよ」R
			【@音無】"「为什么」"R //「どうして」R
			
			@bs(iw0308)
			KOE(000501715,004)【岩沢】"「这不是显然的吗。我只对音乐感兴趣」"R //「そんなの決まってるだろ。あたしは音楽にしか興味がない」R
			
			@bs(iw0307)
			KOE(000501716,004)【岩沢】"「就算你再怎么搭讪，也只会让我困扰而已」"R //「言い寄られても、ただ迷惑なだけなんだよ」R
			【@音無】"「怎么会…」"R //「そんな…」R
			
			@bs(iw0301)
			KOE(000501718,004)【岩沢】"「如果想动心的话，还是找个正经点的女孩子吧」"R //「惚れるなら、まともな奴を探しな」R
			【@音無】"「………」"R //「………」R
			
			@bs(iw0309)
			KOE(000501720,004)【岩沢】"「那拜拜」"R //「じゃあな」R
			
			@bs
			
			"说完之后，岩泽便转身离开了，而我只能这么默默地目送她离开。"R //そう言って背中を向ける岩沢を無言で見送るしかなかった。R

			@岩沢に振られた=1
			@岩沢と個人的に会えなくなる=1

		}		// (曲を褒める/岩沢に惚れる) 選択肢処理のケツ

	}		// (そのまま見送る/追って呼び止める) 選択肢処理のケツ

}		// IF(@岩沢に興味が湧いた==1) のケツ
else
{
	//	▼▼抜けている部分を簡単に補足してみました▼▼		西村
	
	【@音無】"（我觉得这首歌很棒…）"R //（いい曲だと思ったんだけどな…）R
