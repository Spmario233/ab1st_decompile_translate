		//【@音無】（水洗いしてしまったから鮮度は失われたが、ゆりのパンティは消えてはいない。明日以降も使える…今は次のカタルシスのために我慢するべきだ…）R
		【@音無】"（虽然用水洗过之后就不能算是新鲜原味了，但由理的内裤又不会就这么消失。等到明天或者以后还能使用…为了以后的发泄，现在还是先忍耐一下吧…）"R //（水洗いしてしまったから鮮度は失われたが、ゆりのパンツは消えてはいない。明日以降も使える…今は次のカタルシスのために我慢するべきだ…）R
		
		@湯気消去
		@fade(bg_kuro, 25)
		
		"我赶紧从浴池里爬了出来，用冷水浇头，让自己冷静下来。"R //すぐさま浴槽から上がり、頭から水を浴びて色々と冷やす。R
		"然后洗了洗头发和身体，早早地离开了浴池。"R //そして髪と体を洗い、早々に浴場を後にした。R

		;－－－□寮
		@bg(ep99_bg003, 25)
		
		@bs(hn0101)
		KOE(000502097,010)【@日向】"「哟，回来了吗」"R //「よう、戻ってきたか」R
		【@音無】"「我忍住了哦…？」"R //「耐えたぜ…？」R
		
		@bs(hn0107)
		KOE(000502099,010)【@日向】"「哈？忍住了什么？」"R //「は？　何が？」R
		【@音無】"「不，还是不知道比较好」"R //「いや、わからなければいい」R
	}

}ELSE{		// IF(@ゆりへの思い日向がなんとかしてくれる==0)

	#JAAHURO
	
	//この時点で寮の背景が表示されているはず（あまの
	@bs(hn0101)
	KOE(000502108,010)【@日向】"「那么，去洗澡吗」"R //「じゃ、風呂行くか」R

	IF(@岩沢に振られた==1||@岩沢と個人的に会えなくなる==1){

		【@音無】"「好…」"R //「ああ…」R
		
		@bs(hn0109)
		KOE(000502113,010)【@日向】"「不过话说回来，你是真的没什么精神啊」"R //「しかし、ほんと、元気ねーな」R

		IF(@その気さらにあり){
			【@音無】"「没什么，感觉去泡个澡的话，就能恢复精神了…」"R //「いや、ひとっ風呂浴びれば元気になれる、そんな気がする…」R
			
			@bs(hn0104)
			KOE(000502117,010)【@日向】"「这样啊。那趁现在时间还早，赶紧去洗澡吧」"R //「そっか。じゃまだ早い時間だけど早速風呂行くか」R
			【@音無】"「嗯」"R //「ああ」R

			GOTO #HINATAOSHIRI

		}

		@fade(bg_kuro, 25)
		
	}elseif(@裸の日向を見つめた==1){

		【@音無】"「嗯！」"R //「ああっ！」R
		
		@bs(hn0108)
		KOE(000502127,010)【@日向】"「还是一如既往地非常开心啊…」"R //「相変わらずすげー嬉しそうだな…」R

		#HINATAOSHIRI
		
		@fade(bg_kuro, 25)
		
		;－－－□脱衣所
		@湯気
		@bg(ep88_bg025, 25)
		@日向服装=@上半身裸
			
		@bs(hn0101)
		
		"日向的臀部也和往常一样美丽啊…。"R //日向のお尻は相変わらずのイケヒップだ…。R
		"虽然前面被毛巾盖住了，但是…那里应该也很棒吧…？"R //タオルで隠されているが、もしかして…あそこもイケてるのでは…？R

		@@選択=SELBTN(@selbtn_s_2,
			"确认一下", //あそこも確認する,
			"到此为止吧" //そこまではやめておく
		)@selbtn_log
		IF(@選択==0){

			;－－－□大浴場
			@bgs_nf(hn0101)
			
			"我趁着日向闭着眼睛洗头的时候，窥探了一下他的那里。"R //目を瞑り、頭を洗っている日向のあそこを覗き見た。R
			
			@sc_flash_w
			@pcmch_play(1, @大砲爆発)
			@縦揺れ_弱
			
			【@音無】"（如此美丽的长枪！！）"R //（なんて、イケチンなんだ！！）R
			"完全是理想的样子。只能用美丽来形容。"R //理想的。それを美しいとさえ俺は思った。R
			
			//	AB06bの会話整合性をとるためフラグ追加		西村
			@AB04aでイケチン見た=1
			
			@日向のイケチン見た=1
			@実績チェック
			
			@湯気消去
			@fade(bg_kuro, 25)

		}ELSE{	//IF(@選択==1){
			
			@bs
			
			"要是偶然看到就算了，还是不要特意去做那种事情了…。"R //偶然見れるのならまだしも、そこまでの行動は避けておこう…。R
			
			@湯気消去
			@fade(bg_kuro, 25)
		}
		
	}ELSE{

		IF(@０１日ホモ疑惑||@さらにホモ疑惑){

			【@音無】"「你先去吧，我之后再去洗…」"R //「いや、お前の後に入る…」R
			
			@bs(hn0208)
			KOE(000502157,010)【@日向】"「哈啊？为什么这么回避我啊？」"R //「はぁ？　なぜそこまで避けるんだ？」R
			【@音無】"「呃那个…我不想让人看到裸体…」"R //「ええと…俺の裸を見せたくないから…」R
			
			@bs(hn0207)
			KOE(000502159,010)【@日向】"「嗯？是害羞了吗？」"R //「ん？　恥ずかしいのか？」R
			【@音無】"「是的…」"R //「ああ…」R
			
			@bs(hn0408)
			KOE(000502161,010)【@日向】"「嗯…」"R //「うーん…」R
			
			@bs(hn0404)
			KOE(000502162,010)【@日向】"「嘛，行吧。今后我就不邀请你了」"R //「まあ、いいや。これからは誘うのはやめるよ」R
			【@音無】"「那就太好了…」"R //「それは助かる…」R
			
			@bs(hn0102)
			KOE(000502164,010)【@日向】"「你也有自己的原因吧。没事，不用在意」"R //「なんかあるんだろーな。いいぜ、気にすんな」R
			"太好了！"R //助かった！R
			
			@fade(bg_kuro, 25)

			"日向穿着运动服回来之后，我紧接着也去洗澡了。"R //日向がジャージ姿で戻ってきたところで、入れ替わり俺は風呂に入った。R

			@日向と風呂入るのが今後ない=1

		}
		else{		//←追加（あまの）
		
			@fade(bg_kuro, 25)
			
			"我们和平常一样，一起去洗了澡。"R //いつものように、ふたり並んでひとっ風呂浴びた。R
		}
		
	}
	
	@日向服装 = @ジャージ
	@bg(ep99_bg003, 25)

}		// IF(@ゆりへの思い日向がなんとかしてくれる==1) & else の処理おわり（なげー）



