	@bs(hn0404)
	KOE(000501617,010)【@日向】"「回宿舍吧」"R //「寮に戻ろうぜ」R
	"日向拍了拍我的肩膀。"R //ぽん、と肩に手を置かれる。R
	【@音無】"「嗯…」"R //「ああ…」R
	
