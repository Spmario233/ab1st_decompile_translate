		"关于音速的话题",					$check_iwasawa_sel_onoff(@岩沢＿音速の話題), //音速の話題,					$check_iwasawa_sel_onoff(@岩沢＿音速の話題),
		"关于植物的话题",					$check_iwasawa_sel_onoff(@岩沢＿植物の話), //植物の話,					$check_iwasawa_sel_onoff(@岩沢＿植物の話),
		"保证搞笑的话题",					$ikechin_select,		//$check_iwasawa_sel_onoff(@岩沢＿滑らない話), //滑らない話,					$ikechin_select,		
