/********************************************************
*														*
*				ロード直後コールの設定					*
*														*
*********************************************************/
#z00

	// Undoで分岐前に戻ってきた場合は、オートセーブしないようにする
	@オートセーブ制御 = @On

	// メッセージウィンドウボタン初期位置設定
	$msg_btn_pos_init
	
	// 実績エフェクト強制終了
	@実績エフェクト強制終了

	// 「オートセーブしました」再表示防止処理
	@f.obj[@OBJ_BG05].init

	// 「クイックセーブしました」再表示防止処理
	@f.mwnd[$get_mwnd_no].@obj[5].patno = 999

	//汉化版添加：读档后重新挂上歌词显示的逐帧处理
	//（frame action 不会被存档保存，读档后必须重新 start）
	@歌词读档恢复

return


