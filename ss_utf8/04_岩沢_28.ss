			)@selbtn_log
			IF(@選択==0){		// (胸の大きさなんてどうでもいい/やはり大きいに限る) 

				【@音無】"「胸の大きさなんてどうでもいい」"R //「胸の大きさなんてどうでもいい」R
				
				@bs(sk0109, ir0104)
				KOE(040006099,006)【関根】"「え！？　だったら、あたしたちもあなたのおかずに…」"R //「え！？　だったら、あたしたちもあなたのおかずに…」R
