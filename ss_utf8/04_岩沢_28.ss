			@bf(ir0301_04)
			KOE(040006044,007)【入江】"「はあ…」"R //「はあ…」R
			"で、結局俺の立場はどうなったんだ？"R //で、結局俺の立場はどうなったんだ？R

			@@選択=SELBTN(@selbtn_s_2,
				"してると言い通す", //してると言い通す,
				"冗談だったと告げる" //冗談だったと告げる
			)@selbtn_log
			IF(@選択==0){		// (してると言い通す/冗談だったと告げる) 

				【@音無】"「してる。し続ける」"R //「してる。し続ける」R
				
				@bf(sk0107@15)
				@横揺れ_強
				KOE(040006053,006)【関根】"「うああぁぁぁぁぁぁぁぁーーーーーーーー！！」"R //「うああぁぁぁぁぁぁぁぁーーーーーーーー！！」R
				
				@bf(ir0104)
				KOE(040006054,007)【入江】@bc"「え、何？　そんな大きなリアクションされる意味があたし、わかってないんだけど…」"@bf_c(2000, ir0106_04)R //「え、何？　そんな大きなリアクションされる意味があたし、わかってないんだけど…」@bf_c(2000, ir0106_04)R
				【@音無】"「別に減るもんじゃないし、お前らに迷惑をかけてるわけでもないから、いいだろ？」"R //「別に減るもんじゃないし、お前らに迷惑をかけてるわけでもないから、いいだろ？」R
				
				@bf(sk0108@00g, ir0104)
				KOE(040006056,006)【関根】"「うっわー！　ガチだ！」"R //「うっわー！　ガチだ！」R
				
				@bf(sk0109)
				KOE(040006057,006)【関根】@bc"「そりゃ、お好きにどうぞ、としか返せない…」"@bf_c(800, sk0103@00a)@bf_c(1200, sk0109)R //「そりゃ、お好きにどうぞ、としか返せない…」@bf_c(800, sk0103@00a)@bf_c(1200, sk0109)R
				【@音無】"「納得してくれたなら、なによりだ」"R //「納得してくれたなら、なによりだ」R
				
				@bf(sk0108_06)
				KOE(040006059,006)【関根】"「そんな爽やかに下ネタをカミングアウトするとは…」"R //「そんな爽やかに下ネタをカミングアウトするとは…」R
				
				@bf(sk0110@00o)
				KOE(040006060,006)【関根】"「まあ、いいです。まだ想定内です。あたしたちの楽しみはそこにはないので」"R //「まあ、いいです。まだ想定内です。あたしたちの楽しみはそこにはないので」R
				
				@bf(sk0105, ir0104)
				KOE(040006061,006)【関根】"「というわけで、次は岩沢先輩とキスしてください」"R //「というわけで、次は岩沢先輩とキスしてください」R

			}ELSE{	// IF(@選択==1){		// (してると言い通す/冗談だったと告げる) 

				【@音無】"「冗談だよ」"R //「冗談だよ」R
				"そう答えておくほうが、面倒ごとが増えなくていい気がした。"R //そう答えておくほうが、面倒ごとが増えなくていい気がした。R
				
				@bs(sk0104@00a)
				KOE(040006069,006)【関根】"「はあぁぁあーーーーーー！！　安心しました！」"R //「はあぁぁあーーーーーー！！　安心しました！」R
				"どれだけ恐れてたんだよ…。"R //どれだけ恐れてたんだよ…。R
				
				@bf(sk0105)
				KOE(040006071,006)【関根】"「では、次はですね、岩沢先輩とキスしてください」"R //「では、次はですね、岩沢先輩とキスしてください」R

			}

		}ELSE{	// IF(@選択==1){		// (してる/してない) してない

			【@音無】"「すげえ言いがかりだな。してねーよ」"R //「すげえ言いがかりだな。してねーよ」R
			
