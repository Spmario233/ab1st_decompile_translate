			KOE(040006039,007)【入江】"「おな…ぺっと…？」"R //「おな…ぺっと…？」R
			"が、入江には伝わらない。"R //が、入江には伝わらない。R
			
			@bs_set(-1, sk0108@00d, @pos_l + 40)
			@bs_set(-1, ir0304@13, @pos_r - 40)
			@wipe(0)
			KOE(040006041,006)【関根】"「っ！！」"R //「っ！！」R
			
			@bs(bs2_sk0409@00a, ir)
