				【@音無】"「でも、大きすぎるのもなんだか魅力を感じない」"R //「でも、大きすぎるのもなんだか魅力を感じない」R
				
				@bs(sk0107@06@00g, ir0106_03)
				KOE(040006118,006)【関根】"「さじ加減が難しい奴だなぁーー！！」"R //「さじ加減が難しい奴だなぁーー！！」R
				
				@bf(sk0406)
				KOE(040006119,006)【関根】"「でも、岩沢先輩の胸なら許容範囲、と」"R //「でも、岩沢先輩の胸なら許容範囲、と」R

				@@選択=SELBTN(@selbtn_s_2,
					"理想的だ", //理想的だ,
					"やや物足りない" //やや物足りない
				)@selbtn_log
				IF(@選択==0){		// (理想的だ/やや物足りない) 

					【@音無】"「理想的だ」"R //「理想的だ」R
					
					@bf(sk0104@11g, ir0106_03)
					KOE(040006127,006)【関根】"「よーーーしぃぃっ！！」"R //「よーーーしぃぃっ！！」R
					"関根が元気づく。"R //関根が元気づく。R

				}ELSE{	// IF(@選択==1){		// (理想的だ/やや物足りない) 

					【@音無】"「やや物足りない」"R //「やや物足りない」R
					
					@bf(sk0107@00o, ir0106_03)
					KOE(040006133,006)【関根】"「やや物足りないなら、お前が揉んでやって理想的な大きさにすればいいだけだろぉーー！！」"R //「やや物足りないなら、お前が揉んでやって理想的な大きさにすればいいだけだろぉーー！！」R
					【@音無】"「まあ、乳腺を直接刺激すると、大きくなるって話は聞いたことあるな」"R //「まあ、乳腺を直接刺激すると、大きくなるって話は聞いたことあるな」R
					
					@bf(sk0108@00g)
					KOE(040006135,006)【関根】"「なんだ、その医学的根拠のあるような言い方はぁーーー！！」"R //「なんだ、その医学的根拠のあるような言い方はぁーーー！！」R

					IF(@音無最初の記憶を思い出した==0){

						【@音無】"「いや、記憶戻ってないから、自分でもよくわからない」"R //「いや、記憶戻ってないから、自分でもよくわからない」R

					}else{

						【@音無】"「まあ、生前医者を目指してたから、一応」"R //「まあ、生前医者を目指してたから、一応」R
						
						@bf(sk0107@09@00d)
						KOE(040006141,006)【関根】"「知らなかったよ！！」"R //「知らなかったよ！！」R

					}
					
					@bf(sk0110@00a)
					KOE(040006144,006)【関根】"「まあ、いいです」"R //「まあ、いいです」R
					"こほん、とひとつ咳をして一息置く。"R //こほん、とひとつ咳をして一息置く。R

				}		// (理想的だ/やや物足りない) 

				@bf(sk0105, ir0104)
				KOE(040006149,006)【関根】"「では、次はですね、岩沢先輩とキスしてください」"R //「では、次はですね、岩沢先輩とキスしてください」R

			}		// (胸の大きさなんてどうでもいい/やはり大きいに限る) 

		}		// (してる/してない) 

		GOTO #UHYAA

	}ELSE{	// IF(@選択==1){		// (言えない/Ｈなこと) 

		【@音無】"「Ｈなこと」"R //「Ｈなこと」R
		
		@bf(sk0107)
		@横揺れ_強
		KOE(040006164,006)【関根】"「直球で来たああぁーーーーーー！！」"R //「直球で来たああぁーーーーーー！！」R

		GOTO #ATASHITO

	}		// (言えない/Ｈなこと) 

}

