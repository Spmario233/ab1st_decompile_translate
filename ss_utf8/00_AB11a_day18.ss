	"そうだ、と思い出し、銃でもう一度撃ってみる。"R //そうだ、と思い出し、銃でもう一度撃ってみる。R
	"スカンと変な音がして、何かがぽろりと落ちる。"R //スカンと変な音がして、何かがぽろりと落ちる。R
	"それを摘まみ上げて確認してみると、平べったくなった今撃った銃弾だった。"R //それを摘まみ上げて確認してみると、平べったくなった今撃った銃弾だった。R
	【@音無】"（なんてこった…）"R //（なんてこった…）R
	"再び、絶望する…。"R //再び、絶望する…。R
	"重い足取りで、部屋に帰る。"R //重い足取りで、部屋に帰る。R

}
*/

@bgm_play(m301)
;－－－
;;IF(@AB10壁に銃を撃って跳弾し死ぬ){		//■■■■削除予定なので放置。でも一部は残したいなぁ（あまの
//IF(@その気さらにあり){		//▼▼▼参照フラグを変更して、下記のシナリオを活用します。（魁0327
IF(@その気さらにあり||(@おかしい音無１==1||@おかしい音無２==1||@おかしい音無３==1||@おかしい音無４==1)){		//■■■■どれかのフラグが立ってたときのみ入るようにした（あまの 0401
	//TODO:岩泽线结束后翻译
	@日向服装=@ジャージ
	
	@bg(ep99_bg005, 143)

	"阳光透过窗帘的缝隙照射进房间，将我拉出了梦乡。"R //カーテンの隙間から差し込む光で目が醒める。R
	"日向还在喊声响亮地睡着。"R //日向はすーぴーと鼻を鳴らしながら眠っていた。R
	"现在就把他叫醒的话，未免有点太早了。"R //起こすにはまだ早い時間だ。R

	@@選択=SELBTN(@selbtn_s_3,
		"再睡一会儿", //もう少し眠る,
		"睡在日向的旁边",@その気さらにあり, //日向の隣で寝る,@その気さらにあり,
		"把他叫醒",(@おかしい音無１==1||@おかしい音無２==1||@おかしい音無３==1||@おかしい音無４==1)		//■■■■こうしないとシナリオ抜けが発生します（あまの） //起こす,(@おかしい音無１==1||@おかしい音無２==1||@おかしい音無３==1||@おかしい音無４==1)		
	)@selbtn_log
	IF(@選択==0){		// (もう少し眠る/日向の隣で寝る/起こす) もう少し眠る
		
		@fade(bg_kuro, 145)
		
		"我钻进了被子里，闭上了眼睛。"R //俺は布団に潜り、目を閉じた。R
		
		close
		@timewaitkey(3000)

	}ELSEIF(@選択==1){		// (もう少し眠る/日向の隣で寝る/起こす) 日向の隣で寝る
		
		@bgm_stop(2000)
		
		"我爬到了上铺，钻到了日向的被子里。"R //俺は二段目に登り、日向の布団に潜り込んだ。R
		
		@bgs_nf(hn0113, 3)
		@bgm_play(m120, 1000)
		
		【@音無】"（好暖和啊…）"R //（なんて温かいんだ…）R
		"呼～呼～。"R //すーぴーすーぴー。R
		【@音無】"（打呼噜的时候也好可爱…）"R //（そして、なんて可愛らしい寝息なんだ…）R
		
		@bgm_stop(3000)
		@ピンクフィルター消去
		@fade(bg_kuro, 146)
		
		"しばらくその顔を見つめていたが、さすがに睡眠不足だったのか、俺も寝入ってしまった。"R //しばらくその顔を見つめていたが、さすがに睡眠不足だったのか、俺も寝入ってしまった。R
		
		close
		@timewaitkey(3000)
		
		@pcmch_play_loop(1, @目覚まし時計, 800)
		"ぴっぴっぴ…と目覚まし時計の音。"R //ぴっぴっぴ…と目覚まし時計の音。R
		
		@pcmch_stop_all
		@bg(ep99_bg001, 143)
		
		@bs(bs3_hn0101)
		KOE(001400054,010)【@日向】@bc"「ふわぁ…って、なんでお前が居るんだぁーー！！」"@bs_c(1200, hn0106)@横揺れ_弱 R //「ふわぁ…って、なんでお前が居るんだぁーー！！」@bs_c(1200, hn0106)@横揺れ_弱 R

		@bgm_play(m118)
		
		【@音無】"「むにゃむにゃ…おはよう」"R //「むにゃむにゃ…おはよう」R

		@bs(bs2_hn0209_07@00a)
		KOE(001400056,010)【@日向】"「いやいや、いつの間に添い寝状態に！？」"R //「いやいや、いつの間に添い寝状態に！？」R

		@@選択=SELBTN(@selbtn_s_3,
			"底が抜けてお前が落ちてきた", //底が抜けてお前が落ちてきた,
			"すごい寝返りをした", //すごい寝返りをした,
			"夢遊病" //夢遊病
		)@selbtn_log
		IF(@選択==0){		// (底が抜けてお前が落ちてきた/すごい寝返りをした/夢遊病) 底が抜けてお前が落ちてきた

			【@音無】"「底が抜けてお前が落ちてきた」"R //「底が抜けてお前が落ちてきた」R
			
			@bs(hn0206)
			KOE(001400066,010)【@日向】"「えっ！？」"R //「えっ！？」R
			
			@bs(hn0108)
			KOE(001400067,010)【@日向】"「って、上段じゃねーか！　落ちようがねーだろっ！！」"R //「って、上段じゃねーか！　落ちようがねーだろっ！！」R
			【@音無】"「間違えた、俺が浮き上がってきたんだ」"R //「間違えた、俺が浮き上がってきたんだ」R
			
			@bs(hn0306)
			@縦揺れ_弱
			KOE(001400069,010)【@日向】"「言い訳が雑ぅーーーー！！」"R //「言い訳が雑ぅーーーー！！」R
			
			@bs(hn0305)
			KOE(001400070,010)【@日向】"「人が浮き上がって、上段の板も通り抜けて上がってくるはずねぇだろぉーー！！」"R //「人が浮き上がって、上段の板も通り抜けて上がってくるはずねぇだろぉーー！！」R

			GOTO #MATTAKUKONO

		}ELSEIF(@選択==1){		// (底が抜けてお前が落ちてきた/すごい寝返りをした/夢遊病) すごい寝返りをした

			【@音無】"「すごい寝返りをしたようだ…」"R //「すごい寝返りをしたようだ…」R
			
			@bs(hn0105)
			KOE(001400083,010)【@日向】"「なら床に落ちるだろっ！　上段にあがっては来ねーだろっ！！」"R //「なら床に落ちるだろっ！　上段にあがっては来ねーだろっ！！」R

			GOTO #MATTAKUKONO

		}ELSE{	// IF(@選択==2){		// (底が抜けてお前が落ちてきた/すごい寝返りをした/夢遊病) 夢遊病

			【@音無】"「夢遊病だ」"R //「夢遊病だ」R
			
			@bs(hn0105)
			KOE(001400090,010)【@日向】"「そんな病気はこの世界じゃ治ってるはずだぁーー！！」"R //「そんな病気はこの世界じゃ治ってるはずだぁーー！！」R

			IF(@ゆりただのエロ少年にイラっとする==1||@ゆりただのエロ少年にイラっとする２==1||@ゆりただのエロ少年にイラっとする３==1||@ゆりただのエロ少年にイラっとする４==1){	// ||@ゆりただのエロ少年にイラっとする５==1){

				【@音無】"「なら俺の記憶は戻ってるはずですが、何か？」"R //「なら俺の記憶は戻ってるはずですが、何か？」R
				
				@bs(hn0306)
				@横揺れ_弱
				KOE(001400095,010)【@日向】"「それ、俺もイラっと来るぅーー！！」"R //「それ、俺もイラっと来るぅーー！！」R

			}else{

				【@音無】"「でも、記憶喪失も治ってねーし」"R //「でも、記憶喪失も治ってねーし」R

			}

			#MATTAKUKONO
			
			【@音無】"「まったくこの世界は謎だらけだな…こういうこともある。いい経験になったろ…？」"R //「まったくこの世界は謎だらけだな…こういうこともある。いい経験になったろ…？」R
			
			@bs(hn0112)
			KOE(001400074,010)【@日向】"「ええぇぇぇーーー！！」"R //「ええぇぇぇーーー！！」R
			【@音無】"「無限に続く世界だから、まあ、こんなこともあるさ…」"R //「無限に続く世界だから、まあ、こんなこともあるさ…」R
			
			@bs(hn0108)
			KOE(001400076,010)【@日向】"「ええぇぇぇーーー！！」"R //「ええぇぇぇーーー！！」R
			【@音無】"「さ、顔洗って着替えて、飯行こうぜ？」"R //「さ、顔洗って着替えて、飯行こうぜ？」R
			
			@bs(hn0606)
			@横揺れ_弱
			KOE(001400078,010)【@日向】"「ええぇぇぇーーー！！」"R //「ええぇぇぇーーー！！」R

		}		// (底が抜けてお前が落ちてきた/すごい寝返りをした/夢遊病) 
		
		@bgm_stop(2000)
		
		GOTO #SYOKUDOU

	}ELSE{	// IF(@選択==2){		// (もう少し眠る/日向の隣で寝る/起こす) 起こす
		
		@縦揺れ_弱
		
		【@音無】"「起きろ、朝だぞぉー！！」"R //「起きろ、朝だぞぉー！！」R
		"はしごを登り、大声で日向にそう告げる。"R //はしごを登り、大声で日向にそう告げる。R
		
		@face(hn0113)
		KOE(001400111,010)【@日向】"「んんー…」"R //「んんー…」R
		"唸るだけで、起きない。"R //唸るだけで、起きない。R

		//IF(@おかしい音無１==1||@おかしい音無２==1||@おかしい音無３==1||@おかしい音無４==1){		//■■■■この条件でしか入れないように変更したのでコメントアウト（あまの）

		@@選択=SELBTN(@selbtn_s_2,
			"鼻をつまむ", //鼻をつまむ,
			"目つぶしする" //目つぶしする
		)@selbtn_log
		IF(@選択==0){		// (鼻をつまむ/目つぶしする) 鼻をつまむ

			"日向の鼻を息ができないようにつまむ。"R //日向の鼻を息ができないようにつまむ。R
			
			@face(hn0113_14)
			KOE(001400123,010)【@日向】"「んっ…」"R //「んっ…」R
			
			@face(hn0110_09)
			KOE(001400124,010)【@日向】"「んんんっ…」"R //「んんんっ…」R
			
			@bs(bs3_hn0106@u3)
			@縦揺れ_弱
			KOE(001400125,010)【@日向】"「ぷはあぁぁーーー！！　ああぁぁーー！？」"R //「ぷはあぁぁーーー！！　ああぁぁーー！？」R

			@bs(hn0105)
			"起きた途端、俺の顔を見る。"R //起きた途端、俺の顔を見る。R
			
			@bs(hn0208)
			KOE(001400127,010)【@日向】"「お前かよっ…なにしてくれてんだよ…」"R //「お前かよっ…なにしてくれてんだよ…」R

			@bs(bs2_hn0209@00a)
			
			"日向は目覚まし時計を確認する。"R //日向は目覚まし時計を確認する。R
			
			@bs(hn0209_07)
			KOE(001400129,010)【@日向】"「１時間も早いじゃねーか…」"R //「１時間も早いじゃねーか…」R
			【@音無】"「早起きは三文の徳だぜ？」"R //「早起きは三文の徳だぜ？」R
			
			@bs(hn0209)
			KOE(001400131,010)【@日向】"「なんの得になるんだよ…」"R //「なんの得になるんだよ…」R
			【@音無】"「うーん…健康的に」"R //「うーん…健康的に」R
			
			@bs(hn0108)
			KOE(001400133,010)【@日向】"「だから、病まない世界だから、んなもん関係ねーんだよ…」"R //「だから、病まない世界だから、んなもん関係ねーんだよ…」R
			【@音無】"「だったな、わりぃ…」"R //「だったな、わりぃ…」R

			IF(@日向とキャッキャウフフした>=1){

				@bgm_stack
				@bgm_stop(2000)
				
				@bs(hn0102)
				KOE(001400138,010)【@日向】"「反省の色が見られない。なので、こうしてやるーー！！」"R //「反省の色が見られない。なので、こうしてやるーー！！」R

				@bgm_play(m090)		;;キャッキャウフフスタート！
				@timewaitkey(1000)
				@キャッキャウフフ開始(hn0102, 3)

				"日向が起き上がり、俺の鼻と口を両手で塞いでくる。"R //日向が起き上がり、俺の鼻と口を両手で塞いでくる。R
				"よけようとすると、はしごから落ちてしまう。激痛が走り、動けなくなる。"R //よけようとすると、はしごから落ちてしまう。激痛が走り、動けなくなる。R
				
				@bs_w(2, hn0103)
				KOE(001400141,010)【@日向】"「勝機！」"R //「勝機！」R
				"その床に倒れた俺に日向が襲いかかってくる。"R //その床に倒れた俺に日向が襲いかかってくる。R
				
				@bs_w(2, hn0102)
				KOE(001400143,010)【@日向】"「このやろぉーー！！」"R //「このやろぉーー！！」R
				【@音無】"「打撲、打撲ーー！！」"R //「打撲、打撲ーー！！」R
				
				@bs_w(2, hn0104)
				KOE(001400145,010)【@日向】"「そんなこと知るかぁーー！！」"R //「そんなこと知るかぁーー！！」R
				
				"マウントポジションを取られ、口と鼻を押さえられる。"R //マウントポジションを取られ、口と鼻を押さえられる。R
				;;KOE(001400147,010)【@日向】「だもむ…ももふ…！！」R
				【@音無】"「だもむ…ももふ…！！」"R //「だもむ…ももふ…！！」R
				
				"手で床を叩く。"R //手で床を叩く。R
				
				@bs_w(2, hn0102)
				
				KOE(001400149,010)【@日向】"「タップしても許さねーぜ！？」"R //「タップしても許さねーぜ！？」R
				"その手を噛んでやる。"R //その手を噛んでやる。R
				
				@bs_w(2, hn0104)
				//@横揺れ_弱
				KOE(001400151,010)【@日向】"「いてぇーー！！　噛むのは反則だろぉーー！！」"R //「いてぇーー！！　噛むのは反則だろぉーー！！」R
				;;KOE(001400152,010)【@日向】「ここから反撃だぁーー！！」R
				【@音無】"「ここから反撃だぁーー！！」"R //「ここから反撃だぁーー！！」R

				"ひるんだ日向を押し倒し、逆にマウントポジションを取り、その鼻と口を押さえてやる。"R //ひるんだ日向を押し倒し、逆にマウントポジションを取り、その鼻と口を押さえてやる。R

				@bs_w(2, hn0102)
				
				"がぶっ。"R //がぶっ。R

				//@縦揺れ_弱
				
				【@音無】"「いてぇーー！！　噛むのは反則だろぉーー！！」"R //「いてぇーー！！　噛むのは反則だろぉーー！！」R
				
				@bs_w(2, hn0104)
				KOE(001400156,010)【@日向】"「先にお前が噛んだんじゃねーかよぉーー！！」"R //「先にお前が噛んだんじゃねーかよぉーー！！」R
				
				@bgm_stop(3000)
				@キャッキャウフフ終了フェード
				
				"また、ふたりでキャッキャウフフした。"R //また、ふたりでキャッキャウフフした。R

				@噛みつきながらキャッキャウフフした=1
				@実績チェック
				
				@キャッキャウフフ終了(ep99_bg005)
				
				@bgm_pop_play
				【@音無】"「ふぅ…はぁ…はぁ…」"R //「ふぅ…はぁ…はぁ…」R
				
				@bs(hn0109)
				KOE(001400159,010)【@日向】"「はぁ…はぁ…なぜこんな時間から、ハッスルしなくちゃならないんだ…」"R //「はぁ…はぁ…なぜこんな時間から、ハッスルしなくちゃならないんだ…」R
				【@音無】"「だな…」"R //「だな…」R

			}

			
			@bs(hn0109_07)
			KOE(001400164,010)【@日向】"「あーあ、完全に起きちまったし…早いが、顔洗って着替えて、朝食に行くか」"R //「あーあ、完全に起きちまったし…早いが、顔洗って着替えて、朝食に行くか」R
			【@音無】"「こんな時間でも、やってるのか？」"R //「こんな時間でも、やってるのか？」R
			
			@bs(hn0101)
			KOE(001400166,010)【@日向】"「ああ。部活で朝練してるＮＰＣも居るからなぁ」"R //「ああ。部活で朝練してるＮＰＣも居るからなぁ」R
			【@音無】"「なるほど…」"R //「なるほど…」R

			GOTO #SYOKUDOU

		}
		// IF(@選択==1){		// (鼻をつまむ/目つぶしする) 目つぶしする

		"人差し指と中指をＶ字に立て、日向の瞼に思い切り突き刺す。"R //人差し指と中指をＶ字に立て、日向の瞼に思い切り突き刺す。R
		
		close
		@sc_flash_w
		@横揺れ_弱
		
		@bs(bs3_hn0610@u3)
		@縦揺れ_弱
		KOE(001400172,010)【@日向】"「ぎゃあああぁぁぁああぁぁあああーーーーー！！」"R //「ぎゃあああぁぁぁああぁぁあああーーーーー！！」R

