			;;■■コメントアウト待避298■■

			;－－－●↓日向以外の呼称のケースあるよね…？ 参照フラグ教えて…R
			【@音無】"（登ってこない限りは見つからないが…日向ならひょいと登ってきそうだ…！！）"R //（登ってこない限りは見つからないが…日向ならひょいと登ってきそうだ…！！）R
			【@音無】"「すまん、エエエロ…じゃなく、まったく問題ないから、エロままで、いや、このままでいい！」"R //「すまん、エエエロ…じゃなく、まったく問題ないから、エロままで、いや、このままでいい！」R
			
			@face(hn0109_07)
			KOE(001401858,010)【@日向】"「そっか…じゃ、改めておやすみ」"R //「そっか…じゃ、改めておやすみ」R
			【@音無】"「ああ、おやすみ」"R //「ああ、おやすみ」R

			GOTO #NEMURU

		}else{		// not (@AB04いやらしい漫画読み始めた==1)

			;－－－●↓日向じゃない場合ありえるよね…？　参照フラグを…R
			"ということは、日向の汗や匂いが染みついた布団で寝ることになる…。"R //ということは、日向の汗や匂いが染みついた布団で寝ることになる…。R

			;－－－●↓このフラグだけでは駄目な気がする…R
			;;■■コメントアウト待避299■■

			IF(@その気さらにあり){

				【@音無】"（それはアリだ！）"R //（それはアリだ！）R
				【@音無】"「替わろう」"R //「替わろう」R
				
				@face(hn0109_07)
				KOE(001401886,010)【@日向】"「今からかよ…じゃ、布団一式交換すっか」"R //「今からかよ…じゃ、布団一式交換すっか」R
				【@音無】"（えぇ！？　それじゃ、俺が上に行くだけじゃないか！！）"R //（えぇ！？　それじゃ、俺が上に行くだけじゃないか！！）R

			}else{

				【@音無】"（それはなんとなく嫌だな…）"R //（それはなんとなく嫌だな…）R

			}

			【@音無】"「いや、やっぱこのままでいい」"R //「いや、やっぱこのままでいい」R
			
			@face(hn0108)
			KOE(001401896,010)【@日向】"「えーーー、なんだよ、たたみかけてたのに…」"R //「えーーー、なんだよ、たたみかけてたのに…」R
			【@音無】"「すまん…」"R //「すまん…」R
			
			@face(hn0109)
			KOE(001401898,010)【@日向】"「じゃ、改めておやすみ」"R //「じゃ、改めておやすみ」R
			【@音無】"「おやすみ」"R //「おやすみ」R
				
			GOTO #NEMURU

		}		// IF(@AB04いやらしい漫画読み始めた==1) else

	}ELSE{	// IF(@選択==2){		// (素直に話す/はぐらかす/糞した) 

		@bgm_stop(200)
		【@音無】"「糞した」"R //「糞した」R
		
		@face(hn0106)
		KOE(001401908,010)【@日向】"「えっ！？　今！？」"R //「えっ！？　今！？」R
		【@音無】"「ああ…匂いがしたらすまん…おやすみ…」"R //「ああ…匂いがしたらすまん…おやすみ…」R
		
		@face(hn0306)
		@横揺れ_弱
		KOE(001401910,010)【@日向】"「えぇー！？　そのまま眠るの！？」"R //「えぇー！？　そのまま眠るの！？」R
		【@音無】"「ぐーー…ぐーーー…」"R //「ぐーー…ぐーーー…」R
		
		@face(hn0306)
		KOE(001401912,010)【@日向】"「えええぇぇーー！！」"R //「えええぇぇーー！！」R

		@AB11糞して寝た=1

		GOTO #NEMURU
	}

}

#NEMURU

// -------------------------------------------------------------
// 終了 ※必ずこのコマンドで〆て下さい（引数はマニュアル参照）
// -------------------------------------------------------------
@end_day

return

