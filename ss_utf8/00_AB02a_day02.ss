【@音無】"「这么随意真的好吗…」"R //「そんなに適当でいいのかよ…」R

@bs(hn0403)
KOE(000300186,010)【@日向】"「这个世界可是长生不老的，时间也是无限的。没必要心急」"R //「歳も取らず無限に続く世界だからな。最初から飛ばす必要はねーよ」R

@@選択=SELBTN(@selbtn_s_2,
	"和日向一起行动", //日向と行動する,
	"自己一个人行动" //ひとりで行動する
)@selbtn_log
IF(@選択==0){			// 和日向一起行动

	【@音無】"「我可以和你一起练习吗？」"R //「日向のトレーニングに付き合ってもいいかな」R

	IF(@０１日気がある){

		@bs(hn0104)
		KOE(000300198,010)【@日向】"「嗯，行啊」"R //「ああ、いいぜ」R
		"他爽快地答应了。"R //快諾してくれて、嬉しくなる。R

	}elseif(@０１日ホモ疑惑){		// elseif にすべき（西

		@bs(hn0103)
		KOE(000300203,010)【@日向】"「嗯，行啊！」"R //「ああ、いいぜ！」R
		"他答应的这么爽快，反倒让我有点害怕…。"R //あまりの快諾ぶりに、恐怖を覚えてしまう…。R

	}
	
	// k-takahashi ↓缺了else，给加上
	else
	{
		@bs(hn0104)
		KOE(000300198,010)【@日向】"「嗯，行啊」"R //「ああ、いいぜ」R
	}
	// k-takahashi ↑

	@fade(bg_kuro, 25)
	farcall(＿日向+"_01")

	@bgm_stop(1000)

	@アイキャッチフェード

	GOTO #DEWAHON2

}ELSE{	// IF(@選択==1)		// 自己一个人行动

	@０２日音無ひとりで行動=1

	【@音無】"「那我就自己一个人行动了」"R //「俺はひとりで行動するよ」R
	
	@bs(hn0402)
	KOE(000300217,010)【@日向】"「那也不错。对于新人而言，四处走走，和同伴们见见面也挺有意义的」"R //「そりゃ有意義だ。新米だから、いろんな場所に行ったり、仲間と会ったりするべきだな」R

	IF(@０１日気がある){

		"不知道怎么回事，听起来就像是在赶我走一样…。"R //なぜか、それが突き放されたように聞こえてしまう…。R
		"但是，作为室友的话，我肯定会比其他人更和日向亲近的。"R //でも、ルームメイトなのだから、誰よりも親しくなれると思う。R
		"这样想着的我，抛弃了这些胡思乱想，行动了起来。"R //なのでその思い、今は振り切って、行動しよう。R

	}else{
		@bs(hn0102)
		KOE(000300227,010)【@日向】"「我们有很多个性鲜明的成员，加油吧—」"R //「癖の強い連中が揃ってるから、頑張れよー」R
		【@音無】"「我已经亲身感受过了…」"R //「それはすでに肌で感じてるよ…」R

	}

	@bs(hn0101)
	KOE(000300232,010)【@日向】"「哦对了，昨天晚上搞龙卷风的时候，你就只捡到了一张饭票吧」"R //「あと、お前、昨日のトルネードで拾った食券、一枚だけだろ」R
	【@音無】"「嗯」"R //「ああ」R
	
	@bs(hn0104)
	KOE(000300234,010)【@日向】"「这些给你，饿了的时候可以随时去吃」"R //「いつでも好きに食えるように、ほら、やるよ」R
	"他从口袋里掏出了一些饭票，然后塞到了我的手心里。"R //ポケットから適当に食券を俺の手のひらにばらばらと載せてくれる。R
	【@音無】"「谢啦」"R //「ありがたい」R
	
	@bs(hn0102)
	KOE(000300237,010)【@日向】"「下次龙卷风的时候，记得敞开了捡嗷」"R //「次のトルネードでは、ちゃんとたくさん拾えよ」R
	【@音無】"「行」"R //「ああ」R

	@二日目で食券もらった=1
	
}		// "和日向一起行动" 和 "自己一个人行动" 的选择分支

@bgm_stop(1000)

@アイキャッチフェード


