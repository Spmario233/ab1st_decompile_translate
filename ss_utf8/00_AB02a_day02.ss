	@face(hn0105_06)
	KOE(000301490,010)【@日向＿重複】"「音無ぃーー！！」"R //「音無ぃーー！！」R

	@鉄球に対して銃を撃った=1

	@fade(bg_kuro, 2)
	
	#TEKKYU

	@pcmch_stop(0, 2800)

	@bgm_stop(3000)
	@QUAKE_END
	@集中線終了
	
	// todo k-takahashi メモ：gameover的な演出があってもいいかもしれない
	
	;－－－●　下敷きになった後、眼前に迫ってくるというのはおかしくない？
	;迫り来る鉄球の下敷きになる。R
