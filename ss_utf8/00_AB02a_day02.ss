;－－－□学食　お昼
@移動(ep88_bg020)

@bgm_play(M106)

IF(@岩沢と個人的に会えなくなる){

	"明明到了中午了，但是再也无法拜访岩泽的打击，让我完全没有食欲。还是先去食堂看看吧…。"R //時間はお昼時なのに、岩沢にもう個人的に会えなくなるショックが大きすぎて、まったく食欲が湧かないが、とりあえず食堂に移動しよう…。R
	
	@bg(ep05_bg047, 25)
	
	"站到点餐机面前的时候，我才意识到自己身无分文。"R //券売機の前に立つが、お金がないことに気づく。R

	IF(@二日目で食券もらった){

		"然后我想起来了。就用日向给我的饭票吧。"R //そうだ、と思い出す。日向にもらった食券を使おう。R

		GOTO #HINATANIMORATTA

	}else{

		"呆然と立ち尽くす。"R //呆然と立ち尽くす。R

	}

}
// k-takahashi ↓くくらないとおかしくなるのでelseでくくります
else
{
	"肚子饿了…。"R //腹が減ったな…。R

	IF(@二日目で食券もらった){

		"就用日向给我的饭票吧。"R //日向にもらった食券を使おう。R
		
		@fade(bg_kuro, 25)
		
		"我前往了大食堂。"R //大食堂に向かう。R

	}else{

		"但我没有饭票。"R //しかし食券がない。R
		
		@fade(bg_kuro, 25)
		
		"总之先去大食堂吧。"R //とりあえず、大食堂に向かう。R

	}

	@bg(ep05_bg047, 25)
}

;－－－□大食堂
//	自由行動で野田と会った場合のみ辻褄が合わないので、分岐を追加しておきます		西村
IF(@野田で怪我してる==1){

	@pcmch_play_loop(1, @ガヤ,1300)

	GOTO #HINATANIMORATTA

}else{

	@pcmch_play_loop(1, @ガヤ,1300)

	"日向和大山已经并排坐在了桌子旁，享受着午餐。"R //日向と大山が横に並んでテーブルに座り、食事をしていた。R

}

IF(@二日目で食券もらった){

	#HINATANIMORATTA

	"日向给我的饭票被我放在了口袋里。"R //日向にもらった食券はポケットに入れてある。R
	"我把饭票掏了出来，看着上面的菜品。"R //それらをすくい上げ、メニューを見てみる。R
	【@音無】"（" @ruby餐品1_冬阴功咖喱 "？这张也是冬阴功咖喱！？）"R //（トムヤムカレー？　こっちもトムヤムカレー！？）R
	"其他的饭票也全都是冬阴功咖喱。"R //他の食券もすべて、トムヤムカレーだった。R
	【@音無】"（说到冬阴功的话，里面肯定是有香菜。这味道好像相当很挑人吧…？）"R //（トムヤムということは、パクチーが入っているはず。かなり癖がある味じゃなかったか…？）R
	【@音無】"（日向可能只是把不喜欢吃的东西硬塞给了我…不排除这种可能性…）"R //（日向は、苦手なそれをただ押しつけただけ…という可能性もあるが…）R
	"总之先尝尝再说。我把餐券交给了柜台。"R //とりあえずは食べてみよう。食券をカウンターに差し出す。R

	@pcmch_stop(1, 2000)

	"从外表上看，只是一盘普普通通的咖喱而已。"R //見た目は普通のカレーが皿に盛られ、盆に載って現れる。R
	"但我刚端起托盘，一股刺鼻的香菜味就扑面而来。"R //その盆を持ってすぐ、パクチーの強烈な匂いが鼻をつく。R
	【@音無】"（这味道也太冲了吧！而且学校食堂里为什么会有这种菜啊！？）"R //（なんてえげつない香りだ！　そしてなぜこんなメニューが学食にある！？）R
	
	IF(@野田で怪我してる==0){				// 2日目午前で野田に会ってない場合の処理
		
		@bg(ep88_bg009, 25)
		
		@face(hn0101)
		KOE(000300454,010)【@日向】"「喂，音无，这边！」"R //「お、こっちだ音無！」R
		"日向注意到了我，向我呼喊道。"R //日向が俺に気づいて、呼んでくれる。R

		@@選択=SELBTN(@selbtn_s_2,
			"坐在日向的对面", //日向の正面に座る,
			"坐在别的桌子上" //別のテーブルに座る
		)@selbtn_log
		IF(@選択==0){	// 坐在日向的对面

			@bg(ep88_bg013, 25)
			
			"我端着盘子，坐到了日向的面前。"R //その盆を持って、日向の正面に座る。R
			
			
			@bs(hn0306)
			KOE(000300464,010)【@日向】"「这味儿！」"R //「くっさ！」R
			
			@bs(hn, oy0107)
			KOE(000300465,014)【大山】"「我也受不了这道菜…！」"R //「それ、僕も苦手なメニュー…！」R
			"大山坐在日常的身旁，正吃着蛋包饭。"R //日向の隣には大山が居て、オムライスを食べていた。R
			【@音無】"「果然，日向…你只是把自己不喜欢吃的东西全部扔给了我而已吧…」"R //「やっぱり、日向…お前の苦手メニューの食券を俺に押しつけただけなんだな…」R
			
			@bf(hn0108)
			KOE(000300468,010)【@日向】"「毕竟这个太正宗了，只有印度人才会喜欢吧！？」"R //「だって、それ本格的すぎて、インド人の口にしか合わねーぜ！？」R
			//	語尾微調整		西村
			//【@音無】「カレーだが、トムヤムカレーはタイ料理だが？」R
			【@音無】"「虽然这是咖喱，但是冬阴功可是泰国的哦？」"R //「カレーだが、トムヤムカレーはタイ料理だぞ？」R
			
			@bf(hn0106)
			KOE(000300470,010)【@日向】"「诶诶诶———！！原来是这样吗…」"R //「えぇぇーーー！！　そうだったのか…」R
			
			@bf(hn0102)
			KOE(000300471,010)【@日向】@bc"「但是，饥饿可是最好的…调…调味料？对…对吧？」"@bf_c(2700,hn0208) R //「でも、空腹は最高の…ス…スパイス？　で…合ってるか？」@bf_c(2700,hn0208) R
			【@音無】"「嗯，没错。饥饿是最好的调味料」"R //「ああ、合ってるよ。空腹は最高のスパイスだ」R
			
			@bf(hn0102)
			KOE(000300473,010)【@日向】"「那你肯定能品尝出这道菜的美味了哦？」"R //「だったら、きっと美味しく感じられるはずだぜ？」R

			IF(@岩沢と個人的に会えなくなる){

				;－－－■■＠■■テキスト修正　腹減ったと発言していたので（角）R
				;だが、今の俺は空腹など感じられないぐらい惨めな気分でいる…。R
				"但是，现在的我相当痛苦，完全感受不到吃东西的喜悦…。"R //だが、今の俺は食べる喜びなど感じられないぐらい惨めな気分でいる…。R

			}else{		// @岩沢と個人的に会えなくなる==0

				【@音無】"「也许吧」"R //「かもな」R
				"我冷淡地回答道。"R //冷たく言い放つ。R
				
				@bs
				
				【@音無】"（好，那就开动吧…）"R //（さて、頂くとするか…）R

			}
			@bs

			"我用勺子舀了一勺冬阴功咖喱，送进了嘴里，品尝着味道。"R //トムヤムカレーをスプーンですくい、口に放り込み、吟味する。R
			【@音無】"（好冲的味道！！太正宗了！）"R //（なんて臭さだ！！　本格的すぎるだろ！）R

			IF(@岩沢と個人的に会えなくなる){

				;－－－■■＠■■テキスト修正　完食フラグ立てのため変更
				;食欲もない上にこの味。残すしかなかった。R
				"我本身就没有什么胃口。这个味道更是给我已经相当低落的情绪又补了一刀。"R //食欲もない上にこの味。沈んだ心への見事な追い撃ちだ。R

				;－－－■■＠■■完食分岐はここでのフラグで生かすことにします。レアイベントになってしまいますが（角）R
				;出来るだけレアにはしたくないけど、致し方なかったらＯＫ（前田
				"就这么慢吞吞地吃着，整个人都要变成香菜味了…。"R //だらだらと食べていると、体中にパクチー臭がしみこんでいく気がする…。R

				@トムヤムカレー臭い=1

				;【@日向】「今はいいんだよ。いつか、その味をもう一度欲する時が来る」R
				;【@音無】「だといいんだが…」R

				;GOTO #GOGO

			}

			@fade(bg_kuro, 25)

			"但是，我还是把它吃完了。"R //でも、なんとか完食した。R

			@bgs(ep88_bg013, oy0303, 25)
			
			;@bs(oy0303)
			KOE(000300512,014)【大山】"「好厉害，音无君！」"R //「すごいよ、音無くん！」R
			【@音無】"「嗯…」"R //「ああ…」R

			@トムヤムカレー完食した=1

		}ELSE{		// IF(@選択==1)	// 坐在别的桌子上

			IF(@０１日ホモ疑惑){

				【@音無】"（他的同性恋嫌疑还没洗清…装作没注意到他吧…）"R //（まだホモ疑惑は払拭できていない…あえて無視しよう…）R
				
				@bg(ep88_bg013, 25)
				
				"我在附近的空桌子上坐了下来。"R //近場の空いたテーブルにつく。R

			}else{		// @０１日ホモ疑惑==0

				@bg(ep88_bg013, 25)
				
