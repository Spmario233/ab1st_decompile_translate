}ELSE{	//IF(@選択==2)		// (日向に身を預ける/真っ直ぐ走る/迎え撃つ) 迎え撃つ を選択

	【@音無】"「いや、迎え撃つ！」"R //「いや、迎え撃つ！」R
	"俺は銃を取り出し、鉄球を撃つ。"R //俺は銃を取り出し、鉄球を撃つ。R
	
	close
	@pcmch_play(0, @ハンドガン２)
	@sc_flash_w
	
	@face(hn0105)
	KOE(000301499,010)【@日向】"「そんなの、通用するかよっ！！」"R //「そんなの、通用するかよっ！！」R
	
	@bg_pan_zu(ef_guild_trap02, 0, 10000, 0)
	close
	@pcmch_play(0, @ハンドガン２)
	@sc_flash_w
	
	@QUAKE_UD(100, 0, 0, 8)
	
	//	誤字修正。「止まるどろこか」→「止まるどころか」		西村
	//確かに、いくら撃ってもその勢いは止まるどろこか、増すばかりだ。R
	"確かに、いくら撃ってもその勢いは止まるどころか、増すばかりだ。"R //確かに、いくら撃ってもその勢いは止まるどころか、増すばかりだ。R
	"なんて馬鹿な行動に走ってしまったんだ。"R //なんて馬鹿な行動に走ってしまったんだ。R

