	@縦揺れ_弱
	KOE(020000423,002)【@ゆり】"「干好新人该干的事，好好去训练———！！」"R //「新米らしく、訓練に勤しめぇーーー！！」R
	
	@集中線終了
	@bs(yr0207)
	【@音無】"「啊，嗯…」"R //「あ、ああ…」R
	
	@fade(bg_kuro, 25)
	
	"被赶出去了。"R //追い出される。R
	@ゆりから釘を刺された上追い出される=1

	return(1)
}


